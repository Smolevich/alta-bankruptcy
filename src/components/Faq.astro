---
// Вопросы видны на странице и дублируются в JSON-LD: разметка совпадает с текстом.
interface Props {
	items: { q: string; a: string }[];
}
const { items } = Astro.props;
const ld = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((i) => ({
		'@type': 'Question',
		name: i.q,
		acceptedAnswer: { '@type': 'Answer', text: i.a },
	})),
};
---

<div class="faq not-content">
	{
		items.map((i) => (
			<details>
				<summary>{i.q}</summary>
				<p>{i.a}</p>
			</details>
		))
	}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
