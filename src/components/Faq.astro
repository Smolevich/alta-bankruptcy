---
// Questions are visible on the page and duplicated in JSON-LD: the markup matches the text.
// `more` is "details/source" links under the answer; they do not go into JSON-LD, the answer there is without them.
// Props do not pass through rehype-new-tab, so the new tab and PDF viewing are handled here.
import { opensInNewTab } from '../links';
import { bindPercent } from '../rehype-nbsp-percent.mjs';
import { viewerSrc } from '../data/pdfs';

interface Item {
	q: string;
	a: string;
	id?: string;
	more?: [label: string, href: string][];
}
interface Props {
	items: Item[];
	open?: boolean;
}
const { items, open = false } = Astro.props;
const ld = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((i) => ({
		'@type': 'Question',
		name: i.q,
		acceptedAnswer: { '@type': 'Answer', text: i.a },
	})),
};
---

<div class:list={['faq not-content', open && 'faq-open']}>
	{
		items.map((i) => (
			<details id={i.id} open={open}>
				<summary>{bindPercent(i.q)}</summary>
				<p>{bindPercent(i.a)}</p>
				{i.more && (
					<p class="faq-more">
						{i.more.map(([label, url], n) => (
							<>
								{n > 0 && ' · '}
								{opensInNewTab(url) ? (
									<a href={url} target="_blank" rel="noopener" data-pdf={viewerSrc(url) ?? undefined}>
										{label}
									</a>
								) : (
									<a href={url}>{label}</a>
								)}
							</>
						))}
					</p>
				)}
			</details>
		))
	}
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
