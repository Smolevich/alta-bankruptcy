---
// Источники и дата сверки под каждой страницей: читатель видит, на чём держится текст.
import Default from '@astrojs/starlight/components/Footer.astro';
import { LOCALE_TAG, UI, href, langOf } from '../i18n';
import { opensInNewTab } from '../links';
import { viewerSrc } from '../data/pdfs';
import PdfDialog from './PdfDialog.astro';

const lang = langOf(Astro.locals.starlightRoute.lang);
const t = UI[lang];

const data = Astro.locals.starlightRoute.entry.data as {
	sources?: { title: string; url: string; kind: 'official' | 'reliable_media' | 'unverified'; date: Date }[];
	checked?: Date;
};
const fmt = (d: Date) => d.toLocaleDateString(LOCALE_TAG[lang], { timeZone: 'UTC' });
---

{
	data.sources && (
		<aside class="sources not-content" aria-label={t.sources}>
			<h2>
				{t.sources}
				{data.checked && <small>{t.checked} {fmt(data.checked)}</small>}
			</h2>
			<ul>
				{data.sources.map((s) => (
					<li>
						<span class={`kind kind-${s.kind}`}>{t[s.kind]}</span>
						<a href={s.url} target={opensInNewTab(s.url) ? '_blank' : undefined} rel="noopener" data-pdf={viewerSrc(s.url)}>{s.title}</a>
						<time>{fmt(s.date)}</time>
					</li>
				))}
			</ul>
			<p>
				{t.footerHelp} <a href={href(lang, '/pomoch/')}>{t.footerHelpLink}</a>. {t.footerNote} <a href={href(lang, '/pomoch/#about')}>{t.about}</a>.
			</p>
		</aside>
	)
}
<PdfDialog lang={lang} />
<Default><slot /></Default>
