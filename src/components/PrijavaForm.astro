---
// Требование в суд по образцу AOD, заполняемое в браузере: данные не покидают устройство, PDF собирает
// pdf-lib на месте, pdf.js рисует его рядом с формой. Библиотеки и шрифты грузятся со своего адреса при раскрытии формы.
// Должник и дело вписаны по решению суда 10 Ст 275/2026, ПИБ — по списку Управы за јавни дуг; всё правится.
import regularUrl from '../assets/fonts/LiberationSerif-Regular-sub.ttf?url';
import boldUrl from '../assets/fonts/LiberationSerif-Bold-sub.ttf?url';
import { UI, type Lang } from '../i18n';

const { lang = 'ru' } = Astro.props as { lang?: Lang };
const t = UI[lang].prijava;

type Field = { name: keyof typeof t.fields; sr: string; value?: string; area?: boolean };
const groups: [keyof typeof t.groups, Field[]][] = [
	[
		'creditor',
		[
			{ name: 'name', sr: 'име и презиме' },
			{ name: 'address', sr: 'адреса' },
			{ name: 'jmbg', sr: 'ЈМБГ' },
			{ name: 'account', sr: 'рачун бр.' },
			{ name: 'bank', sr: 'назив банке' },
			{ name: 'bankSeat', sr: 'седиште банке' },
		],
	],
	[
		'claim',
		[
			{ name: 'amount', sr: 'укупан износ' },
			{ name: 'basis', sr: 'по основу', area: true },
			{ name: 'evidence', sr: 'докази', area: true },
		],
	],
	[
		'sign',
		[
			{ name: 'place', sr: 'У', value: 'Београду' },
			{ name: 'date', sr: 'дана' },
		],
	],
	[
		'case',
		[
			{ name: 'caseNo', sr: 'Ст.', value: '275/2026' },
			{ name: 'decisionDate', sr: 'Решењем од', value: '03.11.2026.' },
			{ name: 'gazetteNo', sr: '„Службени гласник” бр.' },
			{ name: 'gazetteDate', sr: 'од' },
			{ name: 'days', sr: 'у року од … дана', value: '90' },
			{ name: 'debtor', sr: 'стечајни дужник', value: 'ALTA BANKA AD BEOGRAD – U STEČAJU' },
			{ name: 'debtorSeat', sr: 'из', value: 'Београда' },
			{ name: 'debtorRep', sr: 'ког заступа', value: 'Агенција за осигурање депозита, стечајни управник' },
			{ name: 'debtorMb', sr: 'матични број', value: '07074433' },
			{ name: 'debtorPib', sr: 'ПИБ', value: '100001829' },
		],
	],
];
---

<details class="prijava-box not-content" id="zapolnit">
	<summary>{t.title}</summary>
	<div class="prijava-tabs" role="tablist">
		<button type="button" role="tab" aria-selected="true" data-tab="form">{t.tabForm}</button>
		<button type="button" role="tab" aria-selected="false" data-tab="doc">{t.tabDoc}</button>
	</div>
	<div class="prijava-layout" data-show="form">
		<form class="prijava" id="prijava" data-font-regular={regularUrl} data-font-bold={boldUrl}>
			<p class="prijava-note">{t.privacy}</p>
			<p class="prijava-about">{t.about}</p>
			{
				groups.map(([group, fields]) => (
					<fieldset>
						<legend>{t.groups[group]}</legend>
						{fields.map((f) => {
							const [label, hint] = t.fields[f.name];
							return (
								<label>
									<span>
										{label} <i lang="sr-Cyrl">({f.sr})</i>
									</span>
									{f.area ? (
										<textarea name={f.name} rows="3" />
									) : (
										<input name={f.name} value={f.value ?? ''} autocomplete="off" />
									)}
									{hint && <small>{hint}</small>}
								</label>
							);
						})}
					</fieldset>
				))
			}
			<button type="submit">{t.submit}</button>
			<p class="prijava-status" role="status" data-building={t.building} data-done={t.done} data-open={t.open} data-failed={t.failed}></p>
			<p class="prijava-local">{t.local}</p>
		</form>
		<aside class="prijava-preview" aria-label={t.preview} aria-busy="false">
			<div class="prijava-preview-head">
				<span>{t.preview}</span>
				<span class="prijava-updating" hidden>{t.updating}</span>
			</div>
			<div class="prijava-pages"></div>
			<button type="submit" form="prijava">{t.submit}</button>
		</aside>
	</div>
</details>

<script>
	import type { PrijavaData } from '../lib/prijava-pdf';
	import workerSrc from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';

	const box = document.getElementById('zapolnit') as HTMLDetailsElement | null;
	const form = document.getElementById('prijava') as HTMLFormElement | null;

	// Кнопка «Заполнить онлайн» в карточке бланка ведёт на #zapolnit: раскрываем форму и при переходе по ссылке.
	const openOnHash = () => {
		if (box && location.hash === '#zapolnit') box.open = true;
	};
	openOnHash();
	addEventListener('hashchange', openOnHash);

	if (box && form) {
		const status = form.querySelector<HTMLElement>('.prijava-status')!;
		const layout = box.querySelector<HTMLElement>('.prijava-layout')!;
		const preview = box.querySelector<HTMLElement>('.prijava-preview')!;
		const pages = box.querySelector<HTMLElement>('.prijava-pages')!;
		const updating = box.querySelector<HTMLElement>('.prijava-updating')!;
		const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-tab]')];
		let lastUrl = '';

		const readData = (): PrijavaData => {
			const fd = new FormData(form);
			const get = (k: string) => String(fd.get(k) ?? '');
			const data = Object.fromEntries([...fd.keys()].map((k) => [k, get(k)])) as unknown as PrijavaData;
			data.basis = get('basis').split('\n');
			data.evidence = get('evidence').split('\n');
			return data;
		};

		// Библиотеки и шрифты грузятся один раз — при первом показе формы, не на каждой странице сайта.
		let tools: Promise<[typeof import('../lib/prijava-pdf'), typeof import('pdfjs-dist/legacy/build/pdf.mjs'), { regular: ArrayBuffer; bold: ArrayBuffer }]> | null = null;
		const loadTools = () =>
			(tools ??= Promise.all([
				import('../lib/prijava-pdf'),
				import('pdfjs-dist/legacy/build/pdf.mjs').then((m) => {
					m.GlobalWorkerOptions.workerSrc = workerSrc;
					return m;
				}),
				Promise.all([
					fetch(form.dataset.fontRegular!).then((r) => r.arrayBuffer()),
					fetch(form.dataset.fontBold!).then((r) => r.arrayBuffer()),
				]).then(([regular, bold]) => ({ regular, bold })),
			]));

		const build = async () => {
			const [{ buildPrijava }, , fonts] = await loadTools();
			return buildPrijava(readData(), fonts);
		};

		// Предпросмотр и скачивание собираются одной функцией из одних данных — скачанный PDF совпадает с показанным.
		let run = 0;
		const render = async () => {
			const my = ++run;
			updating.hidden = false;
			preview.setAttribute('aria-busy', 'true');
			try {
				const [, pdfjs] = await loadTools();
				const bytes = await build();
				if (my !== run) return;
				const doc = await pdfjs.getDocument({ data: bytes, isEvalSupported: false }).promise;
				// Рисуем в новые холсты и подменяем разом: старый документ виден, пока новый не готов.
				const ratio = Math.min(devicePixelRatio || 1, 2);
				const width = pages.clientWidth || 600;
				const canvases: HTMLCanvasElement[] = [];
				for (let n = 1; n <= doc.numPages; n++) {
					const page = await doc.getPage(n);
					const base = page.getViewport({ scale: 1 });
					const vp = page.getViewport({ scale: (width / base.width) * ratio });
					const c = document.createElement('canvas');
					c.width = Math.floor(vp.width);
					c.height = Math.floor(vp.height);
					await page.render({ canvas: c, viewport: vp }).promise;
					canvases.push(c);
				}
				await doc.destroy();
				if (my !== run) return;
				pages.replaceChildren(...canvases);
			} catch (err) {
				if (my === run) status.textContent = `${status.dataset.failed} ${(err as Error).message}`;
			} finally {
				if (my === run) {
					updating.hidden = true;
					preview.setAttribute('aria-busy', 'false');
				}
			}
		};

		let timer = 0;
		const schedule = () => {
			updating.hidden = false;
			clearTimeout(timer);
			timer = window.setTimeout(render, 400);
		};
		form.addEventListener('input', schedule);
		if (box.open) render();
		else box.addEventListener('toggle', () => box.open && !pages.childElementCount && render());

		const show = (tab: string) => {
			layout.dataset.show = tab;
			tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
		};
		tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			status.textContent = status.dataset.building!;
			try {
				const bytes = await build();
				if (lastUrl) URL.revokeObjectURL(lastUrl);
				lastUrl = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
				const a = document.createElement('a');
				a.href = lastUrl;
				a.download = 'prijava-potrazivanja.pdf';
				document.body.append(a);
				a.click();
				a.remove();
				// Встроенные браузеры (Telegram на iOS) не умеют download у blob: оставляем ссылку на открытие.
				const open = document.createElement('a');
				open.href = lastUrl;
				open.target = '_blank';
				open.textContent = status.dataset.open!;
				status.replaceChildren(`${status.dataset.done} `, open);
			} catch (err) {
				status.textContent = `${status.dataset.failed} ${(err as Error).message}`;
			}
		});
	}
</script>

<style>
	.prijava-box { margin-top: 1.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; padding: 0.4rem 1rem; }
	.prijava-box > summary { cursor: pointer; font-weight: 600; padding: 0.5rem 0; color: var(--sl-color-text-accent); }
	.prijava { display: grid; gap: 1rem; padding: 0.5rem 0 1rem; min-width: 0; }
	.prijava-layout { display: grid; gap: 1.5rem; }
	.prijava-tabs { display: flex; gap: 0.25rem; margin: 0.25rem 0 0.75rem; }
	.prijava-tabs button {
		flex: 1; font: inherit; font-weight: 600; padding: 0.55rem; border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.4rem; background: var(--sl-color-bg); color: var(--sl-color-text); cursor: pointer;
	}
	.prijava-tabs button[aria-selected='true'] { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: #fff; }
	.prijava-layout[data-show='form'] .prijava-preview, .prijava-layout[data-show='doc'] .prijava { display: none; }
	.prijava-preview { display: grid; gap: 0.75rem; align-content: start; padding: 0.5rem 0 1rem; min-width: 0; }
	.prijava-preview-head { display: flex; justify-content: space-between; gap: 0.5rem; font-weight: 600; color: var(--sl-color-gray-2); }
	.prijava-updating { color: var(--sl-color-text-accent); }
	.prijava-pages { display: grid; gap: 0.75rem; min-height: 12rem; }
	.prijava-pages :global(canvas) { width: 100%; height: auto; display: block; background: #fff; box-shadow: 0 1px 4px rgb(0 0 0 / 0.25); }
	.prijava-preview[aria-busy='true'] .prijava-pages { opacity: 0.6; transition: opacity 0.2s; }
	.prijava-preview button {
		font: inherit; font-weight: 600; padding: 0.75rem 1rem; border: 0; border-radius: 0.5rem;
		background: var(--sl-color-accent); color: #fff; cursor: pointer; justify-self: start;
	}
	.prijava-local { margin: 0; font-size: 0.9rem; color: var(--sl-color-gray-3); }
	@media (min-width: 1024px) {
		.prijava-tabs { display: none; }
		.prijava-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
		.prijava-layout[data-show] .prijava, .prijava-layout[data-show] .prijava-preview { display: grid; }
		.prijava-preview { position: sticky; top: calc(var(--sl-nav-height, 4rem) + 1rem); max-height: calc(100vh - var(--sl-nav-height, 4rem) - 2rem); overflow-y: auto; }
	}
	.prijava fieldset { display: grid; gap: 0.9rem; border: 0; margin: 0; padding: 0; min-width: 0; }
	.prijava legend { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.5rem; padding: 0; }
	.prijava label { display: grid; gap: 0.25rem; }
	.prijava label span { font-weight: 600; }
	.prijava i { font-weight: 400; color: var(--sl-color-gray-3); }
	.prijava input, .prijava textarea {
		font: inherit; padding: 0.55rem 0.65rem; border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.4rem; background: var(--sl-color-bg); color: var(--sl-color-text); width: 100%;
	}
	.prijava small { color: var(--sl-color-gray-3); }
	.prijava button {
		font: inherit; font-weight: 600; padding: 0.75rem 1rem; border: 0; border-radius: 0.5rem;
		background: var(--sl-color-accent); color: #fff; cursor: pointer; justify-self: start;
	}
	.prijava-note { background: var(--sl-color-accent-low); padding: 0.6rem 0.8rem; border-radius: 0.4rem; margin: 0; }
	.prijava-about { margin: 0; }
	.prijava-status { margin: 0; }
</style>
