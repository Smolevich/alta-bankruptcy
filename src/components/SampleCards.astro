---
// A claim sample written by depositors: the same card and the same PDF viewer (data-pdf → PdfDialog)
// as AOD forms, but without "AOD original" links: these documents have no official original.
import type { Lang } from '../i18n';

type Text = Record<Lang, string>;
type Sample = { file: string; title: Text; who: Text; pages: number };

const SAMPLES: Sample[] = [
	{
		file: 'uzorak-deponenata-prijava-potrazivanja',
		title: { ru: 'Образец требования от вкладчиков', en: 'Claim sample from depositors', sr: 'Primer prijave od štediša' },
		who: {
			ru: 'Остаток после выплаты до 50 000 € в Poštanska. Для граждан Сербии (JMBG) и иностранцев (EBS).',
			en: 'The remainder after the payout of up to €50,000 at Poštanska. For Serbian citizens (JMBG) and foreigners (EBS).',
			sr: 'Ostatak posle isplate do 50.000 € u Poštanskoj. Za državljane Srbije (JMBG) i strance (EBS).',
		},
		pages: 2,
	},
];

const T = {
	ru: { label: 'Образцы от вкладчиков', open: 'Открыть', word: 'Word для заполнения', pages: 'стр.' },
	en: { label: 'Samples from depositors', open: 'Open', word: 'Word to fill in', pages: 'pp.' },
	sr: { label: 'Primeri od štediša', open: 'Otvori', word: 'Word za popunjavanje', pages: 'str.' },
};

const { lang = 'ru' } = Astro.props as { lang?: Lang };
const t = T[lang];
---

<ul class="form-cards not-content" aria-label={t.label}>
	{
		SAMPLES.map((s) => {
			const pdf = `/docs/${s.file}.pdf`;
			const view = { href: pdf, target: '_blank', rel: 'noopener', 'data-pdf': pdf, 'data-title': s.title.sr, 'data-no-orig': '' };
			return (
				<li>
					<article class="form-card">
						<a class="form-thumb" {...view} tabindex="-1" aria-hidden="true">
							<img src={`/img/forms/${s.file}.webp`} width="360" height="510" alt="" loading="lazy" decoding="async" />
						</a>
						<div class="form-body">
							<h3>{s.title[lang]}</h3>
							<p class="form-what">{s.who[lang]}</p>
							<div class="form-actions">
								<a class="form-btn" {...view}>
									{t.open}
									<span class="form-btn-note">PDF, {s.pages} {t.pages}</span>
								</a>
								<a class="form-btn form-btn-2" href={`/docs/${s.file}.docx`} download>
									{t.word}
								</a>
							</div>
						</div>
					</article>
				</li>
			);
		})
	}
</ul>
