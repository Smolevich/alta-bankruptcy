---
// Кнопка «Просмотр» и полноэкранная панель с PDF. Работает только со скриптом из PdfViewerScript;
// без него остаётся обычная ссылка «Открыть PDF» рядом.
import { UI, type Lang } from '../i18n';

const { id, title, src, page, lang = 'ru' } = Astro.props as {
	id: string;
	title: string;
	src: string;
	page?: number;
	lang?: Lang;
};
const t = UI[lang];
const embed = `${src}#${page ? `page=${page}&` : ''}view=FitH`;
---

<button type="button" class="doc-preview" hidden data-open={id}>{t.docs.preview}</button>
<dialog class="pdf-dialog" id={id} aria-label={title}>
	<header>
		<strong>{title}</strong>
		<a href={src} target="_blank" rel="noopener">{t.lbl.pdf}</a>
		<button type="button" data-close>{t.docs.close}</button>
	</header>
	<object data-src={embed} type="application/pdf">
		<a href={src} target="_blank" rel="noopener">{t.lbl.pdf}</a>
	</object>
</dialog>
