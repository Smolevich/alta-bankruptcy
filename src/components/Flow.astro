---
// Плитки разделов внизу главной. Номера только у шагов маршрута вкладчика;
// безопасность — предупреждение без номера, остальное — справка без номеров и стрелок.
import { UI, href, type Lang } from '../i18n';

const { lang = 'ru' } = Astro.props as { lang?: Lang };
const t = UI[lang];
const route = t.flow.filter((f) => f[3] === 'route');
const rest = t.flow.filter((f) => f[3] !== 'route');
---

<ol class="flow flow-route not-content" aria-label={t.flowLabel}>
	{
		route.map(([path, title, blurb], i) => (
			<li>
				<a class="flow-tile" href={href(lang, path)}>
					<span class="flow-n" aria-hidden="true">{i + 1}</span>
					<span class="flow-title">{title}</span>
					<span class="flow-blurb">{blurb}</span>
					<span class="flow-go">{t.lbl.inner}</span>
				</a>
			</li>
		))
	}
</ol>

<ul class="flow flow-all not-content" aria-label={t.allSections}>
	{
		rest.map(([path, title, blurb, kind]) => {
			const safe = kind === 'safe';
			return (
				<>
					{path === '/kak-bylo/' && (
						<li class="flow-acct">
							<div class="flow-tile flow-tile-acct">
								<span class="flow-title">{t.acct.title}</span>
								<span class="flow-blurb">{t.acct.blurb}</span>
								<span class="flow-links">
									<a href="/account/stats">{t.acct.stats} →</a>
									<a href="/account">{t.acct.share} →</a>
								</span>
							</div>
						</li>
					)}
					<li>
						<a class:list={['flow-tile', safe && 'flow-tile-safe']} href={href(lang, path)}>
							{safe && <span class="flow-n" aria-hidden="true">!</span>}
							<span class="flow-title">{title}</span>
							<span class="flow-blurb">{blurb}</span>
							<span class="flow-go">{t.lbl.inner}</span>
						</a>
					</li>
				</>
			);
		})
	}
</ul>
