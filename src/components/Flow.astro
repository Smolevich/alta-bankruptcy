---
// Плитки разделов как маршрут: порядок совпадает с боковым меню и «Далее» внизу страниц.
// Плитка безопасности без номера: это предупреждение, а не шаг маршрута.
import { UI, href, type Lang } from '../i18n';

const { lang = 'ru' } = Astro.props as { lang?: Lang };
const t = UI[lang];
let n = 0;
---

<ol class="flow not-content" aria-label={t.flowLabel}>
	{
		t.flow.map(([path, title, blurb, kind]) => {
			const safe = kind === 'safe';
			if (!safe) n += 1;
			return (
				<>
					{path === '/kak-bylo/' && (
						<li class="flow-acct">
							<div class="flow-tile flow-tile-acct">
								<span class="flow-n" aria-hidden="true">€</span>
								<span class="flow-title">{t.acct.title}</span>
								<span class="flow-blurb">{t.acct.blurb}</span>
								<span class="flow-links">
									<a href="/account/stats">{t.acct.stats} →</a>
									<a href="/account">{t.acct.share} →</a>
								</span>
							</div>
						</li>
					)}
					<li>
						<a class:list={['flow-tile', safe && 'flow-tile-safe']} href={href(lang, path)}>
							<span class="flow-n" aria-hidden="true">{safe ? '!' : n}</span>
							<span class="flow-title">{title}</span>
							<span class="flow-blurb">{blurb}</span>
							<span class="flow-go">{t.flowOpen} →</span>
						</a>
					</li>
				</>
			);
		})
	}
</ol>
