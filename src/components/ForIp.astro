---
// A short note for sole proprietors (IP). There is no separate IP section yet:
// every place where the law concerns IP is marked with this component. To remove the marks,
// delete the file and the imports (`grep -rn ForIp src`).
import { UI, type Lang } from '../i18n';

const { lang = 'ru' } = Astro.props as { lang?: Lang };
---

<aside class="for-ip not-content" data-for-ip>
	<strong>{UI[lang].forIp}</strong>
	<slot />
</aside>
