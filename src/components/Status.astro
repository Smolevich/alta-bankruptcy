---
// Крупный блок «Сейчас»: текущая стадия и рельса из всех стадий.
// На телефоне рельса главной сжата до текущей стадии, чтобы первый шаг был на первом экране.
// variant="timeline" (страница /procedura/): только вертикальная шкала, на телефоне тоже полная.
import { getEntry } from 'astro:content';
import { formatDate, UI, href, type Lang } from '../i18n';

const { lang = 'ru', variant = 'home' } = Astro.props as { lang?: Lang; variant?: 'home' | 'timeline' };
const t = UI[lang];
const status = (await getEntry('status', 'current'))!.data;
// sr-Latn уже ставит точку после года («3. 11. 2026.»), а фраза ниже добавляет свою.
const fmt = (d: Date) => formatDate(d, lang);
---

{
	variant === 'timeline' ? (
		<ol class="timeline not-content" aria-label={t.allStages}>
			{status.stages.map((s) => {
				const state = s.n < status.stage ? 'done' : s.n === status.stage ? 'now' : 'next';
				const label = state === 'done' ? t.stageDone : state === 'now' ? t.stageNow : t.stageNext;
				return (
					<li class={`tl-${state}`} aria-current={state === 'now' ? 'step' : undefined}>
						<span class="tl-dot" aria-hidden="true">{state === 'done' ? '✓' : state === 'now' ? '▶' : '○'}</span>
						<span class="tl-state">{label}</span>
						<span class="tl-title">{s.n}. {s.title[lang]}</span>
						{state !== 'next' && <span class="tl-when">{s.when[lang]}</span>}
						{state === 'done' && s.source && (
							<a class="tl-src" href={s.source.url} rel="noopener">{s.source.label[lang]}</a>
						)}
						{state === 'next' && s.trigger && (
							<span class="tl-trigger">{t.stageTrigger}: {s.trigger[lang]}</span>
						)}
					</li>
				);
			})}
		</ol>
	) : (
<section class="status not-content" aria-labelledby="status-h">
	<div class="status-stamp" aria-hidden="true">
		<span class="status-n">{status.stage}</span>
		<span class="status-of">{t.of} {status.stages.length}</span>
	</div>
	<div class="status-body">
		<p class="status-label" id="status-h">{t.statusNow} {status.stage}</p>
		<p class="status-headline">{status.headline[lang]}</p>
		<p class="status-note">{status.note[lang]}</p>
		<p class="status-checked">{t.checkedOn} {fmt(status.checkedAt).replace(/\.$/, '')}. <span class="status-update">{t.statusUpdate}</span> <a class="rail-more" href={href(lang, '/procedura/')}>{t.allStages}: {status.stages.length} →</a></p>
	</div>
	<ol class="rail" aria-label={t.allStages}>
		{
			status.stages.map((s) => (
				<li class:list={[s.n < status.stage && 'done', s.n === status.stage && 'now']} aria-current={s.n === status.stage ? 'step' : undefined}>
					<span class="rail-dot">{s.n < status.stage ? '✓' : s.n}</span>
					<span class="rail-title">{s.title[lang]}</span>
					<span class="rail-when">{s.when[lang]}</span>
				</li>
			))
		}
	</ol>
</section>
)
}
