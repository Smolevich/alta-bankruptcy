---
// Collapsible block for outdated but preserved text (instruction archive). Collapsed by default.
const { title, open = false } = Astro.props as { title: string; open?: boolean };
---

<details class="collapsible" open={open}>
	<summary>{title}</summary>
	<div class="collapsible-body">
		<slot />
	</div>
</details>
