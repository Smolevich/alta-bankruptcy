		estimate: 'estimate',
		showOnMap: 'On the map', gmapsShort: 'Google Maps', satShort: 'Sat', markShort: 'Report', listCount: 'Branches in the list: %n of %m', chartSum: 'Busyness by hour (Google)',
		onMap: 'Open on the map', notMatch: 'Does not match the filters', shownOf: 'Shown %n of %m',
		order: 'Order', orderAod: 'As in the AOD list', orderFree: 'Quieter first', orderNear: 'Nearest', more: 'More',
