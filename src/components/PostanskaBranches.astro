		svOpen: 'Otvori u Google mapama',
		fCity: 'Grad', fAllCities: 'svi gradovi', fSize: 'Veličina', fAllSizes: 'sve', fWhen: 'Kada ići', fAnyTime: 'nije izabrano',
		fDay: 'Dan', fHour: 'Sat',
		fNote: 'Slobodnije nego obično u ovaj sat — u odnosu na vrhunac same ekspoziture, a ne poređenje ekspozitura međusobno.',
		fShown: 'Prikazano ekspozitura: %n', fLabel: 'Filteri ekspozitura', fReset: 'Poništi', noData: 'nema Google podataka', freeAt: 'u ovaj sat %p% vrhunca',
		estimate: 'procena',
