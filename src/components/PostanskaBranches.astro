	'STARA PAZOVA': { latin: 'Stara Pazova', ru: 'Стара-Пазова', en: 'Stara Pazova', sr: 'Stara Pazova' },
	SUBOTICA: { latin: 'Subotica', ru: 'Суботица', en: 'Subotica', sr: 'Subotica' },
	ŠABAC: { latin: 'Šabac', ru: 'Шабац', en: 'Šabac', sr: 'Šabac' },
	VRŠAC: { latin: 'Vršac', ru: 'Вршац', en: 'Vršac', sr: 'Vršac' },
