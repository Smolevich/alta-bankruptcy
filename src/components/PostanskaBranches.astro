		estimate: 'procena',
		showOnMap: 'Na mapi', gmapsShort: 'Google Maps', satShort: 'Sub', markShort: 'Označi', listCount: 'Ekspozitura na spisku: %n od %m', chartSum: 'Opterećenost po satima (Google)',
		onMap: 'Otvoreno na mapi', notMatch: 'Ne odgovara filterima', shownOf: 'Prikazano %n od %m',
