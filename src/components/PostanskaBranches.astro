const QT = QUEUE_TEXT[lang];

function cityKey(naziv: string): string {
	const key = naziv.replace(/^EKSPOZITURA /, '').replace(/ \d+.*$/, '');
	if (!CITIES[key]) throw new Error(`PostanskaBranches: unknown city in "${naziv}"`);
	return key;
}

const mapUrl = (b: Pick<Branch, 'ulicaIBroj' | 'pttBroj'>, city: string) =>
	`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${b.ulicaIBroj}, ${b.pttBroj} ${CITIES[city].latin}, Srbija`)}`;

const ADDR_NOTE: Record<string, string> = { '767': 'Hercegovačka 19' };
const esc = (v: string) => v.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

type Extra = (typeof EXTRA)[keyof typeof EXTRA];
const extraOf = (id: string): Extra | undefined => (EXTRA as Record<string, Extra>)[id];
const sizeText = (e?: Extra) => (e?.size ? T.sizes[e.size as 'small' | 'medium' | 'large'] : null);
function busyText(e?: Extra): string | null {
	if (!e?.peak) return null;
	return `${T.busyWd} ${e.peak}` + (e.peak_saturday ? `, ${T.busySat} ${e.peak_saturday}` : '');
}

type Hist = { weekday: (number | null)[]; sat: (number | null)[] | null };
const GOOGLE_BUSY = 'https://support.google.com/business/answer/6263531';
const HOURS = [8, 12, 16, 20];
// Столбики 8–20 ч, inline SVG: цвета — через currentColor и var(--sl-color-text-accent), чтобы работало в любой теме.
function row(label: string, v: (number | null)[]): string {
	const W = 13 * 10;
	const bars = v
		.map((p, i) => `<rect x="${i * 10 + 1}" y="${30 - (p ?? 0) * 0.28}" width="8" height="${(p ?? 0) * 0.28}" class="bar"/>`)
		.join('');
	const ticks = HOURS.map((h) => `<text x="${(h - 8) * 10 + 5}" y="40" text-anchor="middle" class="tick">${h}</text>`).join('');
	return `<div class="hist-lbl">${esc(label)}</div><svg viewBox="0 0 ${W} 43" class="hist-svg" role="img" aria-label="${esc(label)}: ${v.map((p) => p ?? 0).join(', ')}%"><line x1="0" y1="30.5" x2="${W}" y2="30.5" class="axis"/>${bars}${ticks}</svg>`;
}
// Пояснение к графику одно на раздел — в «Как читать», а не под каждым графиком.
function chart(e?: Extra): string {
	const h = (e as { hist?: Hist | null } | undefined)?.hist;
	if (!h) return '';
	return `<div class="hist" role="group" aria-label="${esc(T.chartLabel)}">${row(T.chartWd, h.weekday)}${h.sat ? row(T.chartSat, h.sat) : ''}</div>`;
}
// Значок «булавка карты» у внешней ссылки на Google Maps: наша карта — без значка, Google — всегда с ним.
const PIN = '<svg class="gm-pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7z" fill="#ea4335"/><circle cx="12" cy="9" r="2.6" fill="#fff"/></svg>';
const histOf = (id: string) => (extraOf(id) as { hist?: Hist | null } | undefined)?.hist ?? null;
// Данные для фильтров: часы 8–20 в атрибутах карточки, скрипт читает их же для карты.
const fa = (id: string, city: string) => ({
	'data-branch': id,
	'data-city': city,
	'data-size': extraOf(id)?.size ?? '',
	'data-wd': histOf(id)?.weekday.join(',') ?? '',
	'data-sat': histOf(id)?.sat?.join(',') ?? '',
});
const noData = (id: string) => !histOf(id);

type Point = { id: string; name: string; addr: string; hours: string; sat: string; code: string; city: string };

const groups = new Map<string, Branch[]>();
for (const b of LIST.ekspoziture) {
	const k = cityKey(b.naziv);
	groups.set(k, [...(groups.get(k) ?? []), b]);
}
const order = [...FIRST, ...[...groups.keys()].filter((k) => !FIRST.includes(k)).sort((a, b) => CITIES[a][lang].localeCompare(CITIES[b][lang], lang))];
const slug = (k: string) => `branches-${CITIES[k].latin.toLowerCase().normalize('NFD').replace(/[^a-z ]/g, '').replace(/ /g, '-')}`;
const S = LIST.specijalizovana;
const SPECIAL_PT: Point = { id: S.sifra, name: S.naziv, addr: `${S.ulicaIBroj}, ${S.pttBroj} ${CITIES.BEOGRAD.latin}`, hours: S.radnoVremeRadnimDanom, sat: S.radnoVremeSubotom, code: S.sifra, city: 'BEOGRAD' };
// Всё, что нужно карточке и списку очередей: часы — строками из PDF AOD, график Google — готовым SVG.
const points = [
	SPECIAL_PT,
	...LIST.ekspoziture.map((b) => ({ id: b.sifra, name: b.naziv.replace(/^EKSPOZITURA /, ''), addr: `${b.ulicaIBroj}, ${b.pttBroj} ${CITIES[cityKey(b.naziv)].latin}`, hours: b.radnoVremeRadnimDanom, sat: b.radnoVremeSubotom, code: b.sifra, city: cityKey(b.naziv) })),
]
	.filter((p) => extraOf(p.id))
	.map((p) => ({
		id: p.id, lat: extraOf(p.id)!.lat, lng: extraOf(p.id)!.lng, city: p.city, cityName: CITIES[p.city][lang], name: p.name, addr: p.addr,
		note: ADDR_NOTE[p.id] ? `${T.bankSite}: ${ADDR_NOTE[p.id]}` : '', wd: p.hours, sat: p.sat, gmaps: extraOf(p.id)!.maps_url ?? '', chart: chart(extraOf(p.id)), code: p.code, tag: p.id === S.sifra ? S.oznaka : '',
	}));
const STATES = ['none', 'few', 'full', 'outside'] as const;
const BANK = '<svg viewBox="0 0 24 24" aria-hidden="true" class="q-bank"><path d="M12 2 2 7v2h20V7L12 2zm-7 9v7h3v-7H5zm5.5 0v7h3v-7h-3zM16 11v7h3v-7h-3zM2 20v2h20v-2H2z" fill="currentColor"/></svg>';
const VOICE_LANG = { ru: 'ru-RU', en: 'en-US', sr: 'sr-RS' }[lang];
const styleUrl = `/map/style-${lang}.json`;
// Строки нижнего списка по городам: карточка AOD (шифра 864) — первой строкой Белграда.
type Row = { id: string; name: string; addr: string; street: Pick<Branch, 'ulicaIBroj' | 'pttBroj'>; wd: string; sat: string; special: boolean };
const gmapsOf = (r: Row, city: string) => extraOf(r.id)?.maps_url || mapUrl(r.street, city);
const rowsByCity = new Map<string, Row[]>(order.map((k) => [k, [
	...(k === 'BEOGRAD' ? [{ id: S.sifra, name: S.naziv, addr: `${S.ulicaIBroj}, ${S.pttBroj} ${CITIES.BEOGRAD.latin}`, street: S, wd: S.radnoVremeRadnimDanom, sat: S.radnoVremeSubotom, special: true }] : []),
	...groups.get(k)!.map((b) => ({ id: b.sifra, name: b.naziv.replace(/^EKSPOZITURA /, ''), addr: `${b.ulicaIBroj}, ${b.pttBroj} ${CITIES[k].latin}`, street: b, wd: b.radnoVremeRadnimDanom, sat: b.radnoVremeSubotom, special: false })),
]]));
const cityCount = (k: string) => rowsByCity.get(k)!.length;
const pdfAttrs = { 'data-pdf': COPY, 'data-title': LIST.title, 'data-orig': LIST.url };
---

<div class="branches not-content" data-count={LIST.ekspoziture.length}>
	<p class="branches-src">
		{T.source} «<span lang="sr-Cyrl">{LIST.title}</span>», {T.published}:{' '}
		<a href={COPY} target="_blank" rel="noopener" {...pdfAttrs}>{T.pdf}</a> ·{' '}
		<a href={LIST.url} target="_blank" rel="noopener">aod.rs<span class="sr-only"> ({T.newTab})</span></a>
		<br /><strong>{T.total(LIST.ekspoziture.length + 1, groups.size)}</strong>
	</p>

	<div class="branch-controls" role="group" aria-label={T.fLabel} data-free={T.freeAt} data-shown={T.listCount} hidden>
		<label class="bc-city"><span class="sr-only">{T.fCity}</span>
			<select class="f-city" aria-label={T.fCity}>
				<option value="">{T.fAllCities} · {points.length}</option>
				{order.map((k) => <option value={k} selected={k === 'BEOGRAD'}>{CITIES[k][lang]} · {cityCount(k)}</option>)}
			</select>
		</label>
		<fieldset class="bc-seg bc-day">
			<legend class="sr-only">{T.fDay}</legend>
			<label><input type="radio" name="f-day" value="wd" checked /><span>{T.weekdays}</span></label>
			<label><input type="radio" name="f-day" value="sat" /><span><abbr title={T.saturday}>{T.satShort}</abbr></span></label>
		</fieldset>
		<details class="bc-more">
			<summary>{T.more}</summary>
			<div class="bc-more-body">
				<label class="bc-field bc-hour">{T.fHour}
					<select class="f-hour">
						<option value="">{T.anyHour}</option>
						{Array.from({ length: 12 }, (_, i) => i + 8).map((h) => <option value={h}>{h}:00</option>)}
					</select>
				</label>
				<fieldset class="bc-seg bc-size">
					<legend>{T.fSize}</legend>
					<label><input type="radio" name="f-size" value="" checked /><span>{T.anySize}</span></label>
					{(['small', 'medium', 'large'] as const).map((k) => <label><input type="radio" name="f-size" value={k} /><span>{T.sizesPl[k]}</span></label>)}
				</fieldset>
				<fieldset class="bc-seg bc-order">
					<legend>{T.order}</legend>
					<label><input type="radio" name="f-order" value="free" checked /><span>{T.orderFree}</span></label>
					<label><input type="radio" name="f-order" value="aod" /><span>{T.orderAod}</span></label>
					<label class="bc-near" hidden><input type="radio" name="f-order" value="near" /><span>{T.orderNear}</span></label>
				</fieldset>
				<p class="f-note" hidden>{T.fNote}</p>
				<button type="button" class="f-reset">{T.fReset}</button>
			</div>
		</details>
	</div>

	<section class="qmap" id="branches-map" data-points={JSON.stringify(points)} data-text={JSON.stringify(QT)} data-style={styleUrl} data-lang={lang} data-voice-lang={VOICE_LANG} aria-label={QT.title}>
		<header class="qmap-head">
			<p class="qmap-title"><Fragment set:html={BANK} /><span>{QT.title}</span></p>
		</header>
		<div class="qmap-body">
			<div class="qmap-panel">
				<button type="button" class="q-report"><Fragment set:html={'<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>'} /><span class="q-report-text">{QT.report}</span></button>
				<p class="q-msg" id="q-msg" aria-live="polite"></p>
				<p class="q-scale"></p>
			</div>
			<div class="qmap-view">
				<div class="qmap-canvas" role="region" aria-label={QT.mapAria}><p class="qmap-loading">{QT.loading}</p></div>
				<button type="button" class="q-stub" hidden><span class="q-stub-grip" aria-hidden="true"></span><span class="q-stub-text">{QT.stub}</span></button>
			</div>
			<div class="q-card" role="region" aria-label={QT.card} hidden></div>
			<div class="bl-box">
				<div class="bl" id="branches-list">
					<p class="bl-count" aria-live="polite"></p>
					{
						order.map((k) => (
							<section class="bl-city" id={slug(k)} data-city={k}>
								<h3>{CITIES[k][lang]} <span class="branch-n">· {cityCount(k)}</span></h3>
								<ul class="bl-rows">
									{rowsByCity.get(k)!.map((r) => (
										<li>
											<details class:list={['bl-row', { 'bl-special': r.special }]} name="branch" {...fa(r.id, k)}>
												<summary>
													<i class="q-dot" data-q="unknown"></i>
													<span class="bl-sum">
														<span class="bl-name"><strong>{r.name}</strong><em class="bl-far"></em></span>
														<small class="bl-status">{T.weekdays} {r.wd} · {T.satShort} {r.sat}</small>
														<small class="bl-addr">{r.addr}</small>
													</span>
												</summary>
												<div class="bl-body">
													{r.special && (
														<div class="q-tag">
															<p class="q-tag-t">{T.special}</p>
															<p class="q-tag-o" lang="sr-Latn">{S.oznaka}</p>
															<p class="q-tag-n">{T.unclear}</p>
														</div>
													)}
													<p class="bl-hours">{T.weekdays} {r.wd} · {T.saturday} {r.sat} · <span class="branch-code">{T.code} {r.id}</span></p>
													{ADDR_NOTE[r.id] && <p class="bl-extra">{T.bankSite}: {ADDR_NOTE[r.id]}</p>}
													{sizeText(extraOf(r.id)) && <p class="bl-extra">{T.size}: {sizeText(extraOf(r.id))} ({T.sizeNote})</p>}
													{busyText(extraOf(r.id)) && <p class="bl-extra">{T.busy}: {busyText(extraOf(r.id))}</p>}
													{noData(r.id) && <p class="bl-extra bl-nodata">{T.noData}</p>}
													<p class="bl-extra f-free" hidden></p>
													{histOf(r.id) && <Fragment set:html={chart(extraOf(r.id))} />}
													<div class="bl-actions">
														<a class="bl-show" href={`?b=${r.id}#branches-map`} data-show={r.id}>{T.showOnMap}</a>
														<a class="bl-gmaps" href={gmapsOf(r, k)} target="_blank" rel="noopener"><Fragment set:html={PIN} /><span>{T.gmapsShort}</span><span class="sr-only"> ({T.newTab})</span></a>
														<button type="button" class="bl-mark" data-mark={r.id} hidden>{T.markShort}</button>
													</div>
												</div>
											</details>
										</li>
									))}
								</ul>
							</section>
						))
					}
					<ul class="bl-rows bl-live" hidden></ul>
					<details class="bl-closed" hidden>
						<summary class="bl-closed-sum"></summary>
						<ul class="bl-rows bl-closed-rows"></ul>
					</details>
				</div>
			</div>
			<div class="qmap-foot">
				<p class="q-note" hidden></p>
				<details class="qmap-legend">
					<summary>{QT.legend}</summary>
					<ul>
						{STATES.map((st) => <li><i class={`q-mini q-mini-${st}`}></i>{QT.states[st]}</li>)}
						<li><i class="q-mini q-mini-few q-mini-fill"></i>{QT.lFill}</li>
						<li><i class="q-mini q-mini-few q-mini-ring"></i>{QT.lRing}</li>
						<li><i class="q-mini q-mini-unknown"></i>{QT.lGrey}</li>
						<li><i class="q-mini q-mini-closed"></i>{QT.lLock}</li>
					</ul>
					<p>{QT.lNote}</p>
					<p>{QT.disclaimer} {QT.reportHint}</p>
					<p>{T.note}</p>
					<p>{T.chartNote} <a href={GOOGLE_BUSY} target="_blank" rel="noopener">{T.chartLink}<span class="sr-only"> ({T.newTab})</span></a></p>
					<p>{T.fNote}</p>
					<p>{QT.privacy}</p>
				</details>
			</div>
		</div>
	</section>

	<p class="branches-phones">
		{T.phones}{' '}
		<a href={POSTED_SEARCH} target="_blank" rel="noopener">{T.phonesLink}<span class="sr-only"> ({T.newTab})</span></a>
	</p>
</div>

<script>
	import { attachVoice, voiceSupported } from '../scripts/voice';
	import { branchStatus, canReport, parseRange, reportsFrom } from '../lib/branch-hours.mjs';
	import { QUEUE_LEVELS, queueLevel, statusTone, weekTiles } from '../lib/branch-card.mjs';
	import { belgradeParts, clockOffset } from '../lib/server-clock.mjs';

	type Info = { el: HTMLDetailsElement; li: HTMLElement; city: string; size: string; wd: number[]; sat: number[] };
	const nums = (v?: string) => (v ? v.split(',').map(Number) : []);
	// Значение — процент от пика самого отделения в этот час; 0 в часы без данных (закрыто) считаем «нет данных».
	function pctAt(i: Info, day: string, hour: number): number | null {
		const v = (day === 'sat' ? i.sat : i.wd)[hour - 8];
		return v ? v : null;
	}

	// Карта очередей Poštanska (ТЗ ux-spec, этап 1). MapLibre, подложка и шрифты — с нашего адреса
	// (public/vendor/maplibre, public/map): сторонние скрипты и тайлы CSP сайта не пускает.

	type Pt = { id: string; lat: number; lng: number; city: string; cityName: string; name: string; addr: string; note: string; wd: string; sat: string; gmaps: string; chart: string; code: string; tag: string };
	type Mark = { state: string; count: number; minutes_ago: number; sure?: boolean };
	type Tx = Record<string, any>;
	type Hours = { open: boolean; text: string; preOpen: boolean; reportsAt: string; next: string };
	type Card = { tone: string; icon: string; title: string; sub: string; canMark: boolean; markWhen: string; marksWhen: string; closed: boolean; later: boolean; inside: boolean };
	type Phase = 'idle' | 'pending' | 'hold' | 'sending' | 'error' | 'done' | 'limit';

	const STATES = ['none', 'few', 'full', 'outside'];
	const SURE_MINUTES = 45;
	const UNDO_MS = 5000;
	const REPEAT_MS = 15 * 60 * 1000;
	const GEO_MIN_M = 150;
	const GEO_SECOND_M = 250;
	const GEO_GIVE_UP_MS = 12000;
	const POLL_MS = 120000;
	const CONTACT = /@|\d[\d\s()+-]{5,}\d/;
	const BANK_PATH = 'M12 2 2 7v2h20V7L12 2zm-7 9v7h3v-7H5zm5.5 0v7h3v-7h-3zM16 11v7h3v-7h-3zM2 20v2h20v-2H2z';
	const LOCK_PATH = 'M7 10V7a5 5 0 0 1 10 0v3h1.5v11h-13V10H7zm2 0h6V7a3 3 0 0 0-6 0v3z';
	const LOCK_SVG = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${LOCK_PATH}" fill="currentColor"/></svg>`;
	// Глифы состояний: галочка, один человек, группа, дверь — чтобы цвет не был единственным признаком.
	const GLYPH: Record<string, string> = {
		none: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>',
		few: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4" fill="currentColor"/><path d="M4 21a8 8 0 0 1 16 0z" fill="currentColor"/></svg>',
		full: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="3.3" fill="currentColor"/><circle cx="16.5" cy="8" r="3.3" fill="currentColor"/><path d="M1.5 20a6.5 6.5 0 0 1 13 0zM10 20a6.5 6.5 0 0 1 12.5 0z" fill="currentColor"/></svg>',
		outside: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4.5L14 2v19zm11-17h3v17h-3zM11 12.5a1 1 0 1 0 0 .01z" fill="currentColor"/></svg>',
		unknown: '', closed: LOCK_SVG,
	};
	// Контурные иконки карточки в духе Lucide, свои пути — без иконочных пакетов.
	const ICON_PATHS: Record<string, string> = {
		lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
		check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
		sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
		clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
		users: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-4-6"/>',
		navigation: '<path d="M3 11 21 3l-8 18-2-8z"/>',
		plus: '<path d="M12 5v14M5 12h14"/>',
		chart: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
		info: '<circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/>',
		chevron: '<path d="m6 9 6 6 6-6"/>',
		x: '<path d="M6 6l12 12M18 6 6 18"/>',
		alert: '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/>',
	};
	const GM_PIN = '<svg class="gm-pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7z" fill="#ea4335"/><circle cx="12" cy="9" r="2.6" fill="#fff"/></svg>';
	const ICON = (name: string) => `<svg class="q-ic" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICON_PATHS[name]}</svg>`;
	const esc = (v: string) => v.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
	const pad = (n: number) => String(n).padStart(2, '0');
	const hhmm = (min: number) => `${Math.floor(min / 60)}:${pad(min % 60)}`;
	const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const store = {
		get: (k: string) => { try { return window.localStorage.getItem(k); } catch { return null; } },
		set: (k: string, v: string) => { try { window.localStorage.setItem(k, v); } catch { /* приватный режим */ } },
	};

	// Номер браузера для подсчёта людей: случайный, живёт в localStorage, ни с чем не связан.
	function deviceId(): string {
		const have = store.get('q-device');
		if (have && /^[A-Za-z0-9-]{16,64}$/.test(have)) return have;
		const id = typeof crypto.randomUUID === 'function' ? crypto.randomUUID() : [...crypto.getRandomValues(new Uint8Array(16))].map((b) => b.toString(16).padStart(2, '0')).join('');
		store.set('q-device', id);
		return id;
	}

	// Место для флага «рядом»: только если разрешение уже дано, отдельно не спрашиваем.
	async function grantedPosition(): Promise<{ lat: number; lng: number } | null> {
		try {
			const perm = await navigator.permissions?.query({ name: 'geolocation' as PermissionName });
			if (perm?.state !== 'granted') return null;
			return await new Promise((resolve) => navigator.geolocation.getCurrentPosition(
				(pos) => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
				() => resolve(null),
				{ enableHighAccuracy: true, timeout: 4000, maximumAge: 120000 },
			));
		} catch {
			return null;
		}
	}

	function distM(a: { lat: number; lng: number }, b: { lat: number; lng: number }): number {
		const r = Math.PI / 180;
		const x = (b.lng - a.lng) * r * Math.cos(((a.lat + b.lat) / 2) * r);
		return Math.hypot(x, (b.lat - a.lat) * r) * 6371000;
	}

	// Часы сервера вместо часов телефона: поправка приходит с GET /api/queue; пока её нет — часы устройства.
	let offset = 0;
	const nowMs = () => Date.now() + offset;
	const belgradeNow = () => belgradeParts(nowMs());
	const range = (text: string) => parseRange(text);
	const rangeText = (text: string) => { const r = range(text); return r ? `${hhmm(r[0])}–${hhmm(r[1])}` : text; };

	async function solvePow(): Promise<string> {
		const r = await fetch('/account/challenge', { cache: 'no-store', credentials: 'omit' });
		if (!r.ok) throw new Error(`challenge ${r.status}`);
		const task = await r.json();
		const enc = new TextEncoder();
		const hex = (b: ArrayBuffer) => [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, '0')).join('');
		for (let start = 0; start <= task.maxnumber; start += 500) {
			const nums: number[] = [];
			for (let n = start; n < Math.min(start + 500, task.maxnumber + 1); n += 1) nums.push(n);
			const hashes = await Promise.all(nums.map(async (n) => hex(await crypto.subtle.digest('SHA-256', enc.encode(task.salt + n)))));
			const i = hashes.indexOf(task.challenge);
			if (i >= 0) {
				const body = { algorithm: task.algorithm, challenge: task.challenge, number: nums[i], salt: task.salt, signature: task.signature };
				return btoa(JSON.stringify(body));
			}
		}
		throw new Error('pow');
	}

	function loadLib(): Promise<any> {
		const base = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'vendor/maplibre/';
		const css = document.createElement('link');
		css.rel = 'stylesheet';
		css.href = base + 'maplibre-gl.css';
		document.head.appendChild(css);
		const pm = new Promise((resolve, reject) => {
			const s = document.createElement('script');
			s.src = base + 'pmtiles.js';
			s.onload = resolve;
			s.onerror = reject;
			document.head.appendChild(s);
		});
		return Promise.all([import(/* @vite-ignore */ base + 'maplibre-gl.mjs'), pm]).then(([lib]) => lib);
	}

	function hasWebGL(): boolean {
		try {
			const c = document.createElement('canvas');
			return Boolean(c.getContext('webgl2') || c.getContext('webgl'));
		} catch {
			return false;
		}
	}

	function initQueue(root: HTMLElement) {
		const pts: Pt[] = JSON.parse(root.dataset.points ?? '[]');
		const tx: Tx = JSON.parse(root.dataset.text ?? '{}');
		const lang = root.dataset.lang ?? 'ru';
		const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
		// Панель фильтров над картой — одна на раздел: город, день, час, размер, порядок действуют и на пины, и на нижний список.
		const box = document.querySelector<HTMLElement>('.branch-controls')!;
		const citySel = box.querySelector<HTMLSelectElement>('.f-city')!;
		const hourSel = box.querySelector<HTMLSelectElement>('.f-hour')!;
		const radio = (name: string) => box.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
		const setRadio = (name: string, value: string) => { const r = box.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`); if (r) r.checked = true; };
		const infos = new Map<string, Info>();
		document.querySelectorAll<HTMLDetailsElement>('.bl-row[data-branch]').forEach((el) => {
			infos.set(el.dataset.branch!, { el, li: el.parentElement!, city: el.dataset.city!, size: el.dataset.size ?? '', wd: nums(el.dataset.wd), sat: nums(el.dataset.sat) });
		});
		const aodIdx = new Map([...infos.keys()].map((id, i) => [id, i]));
		const inCity = (p: { city: string }) => !citySel.value || p.city === citySel.value;
		// Куда вернуть фокус при закрытии карточки, если её открыли кнопкой «Показать на карте».
		let returnTo: HTMLElement | null = null;
		const card = $('.q-card');
		const canvas = $('.qmap-canvas');
		const listBox = $('.bl');
		const live = $('.bl-live');
		const closedBox = $<HTMLDetailsElement>('.bl-closed');
		const closedRows = $('.bl-closed-rows');
		const stub = $<HTMLButtonElement>('.q-stub');
		const msg = $('.q-msg');
		const note = $('.q-note');
		const reportBtn = $<HTMLButtonElement>('.q-report');
		const plural = new Intl.PluralRules(lang === 'sr' ? 'sr-Latn' : lang);
		const form = (n: number, forms: string[]) => { const c = plural.select(n); return forms[c === 'one' ? 0 : c === 'few' ? 1 : 2]; };
		const nMarks = (n: number) => `${n} ${form(n, tx.marks)}`;
		const dur = (min: number) => (min >= 60 ? `${Math.floor(min / 60)} ${tx.h}` + (min % 60 ? ` ${min % 60} ${tx.min}` : '') : `${min} ${tx.min}`);
		const distText = (m: number) => (m < 1000 ? `${Math.round(m / 10) * 10} ${tx.m}` : `${(m / 1000).toLocaleString(lang === 'en' ? 'en' : lang === 'sr' ? 'sr-Latn' : 'ru', { maximumFractionDigits: 1 })} ${tx.km}`);
		const narrow = () => root.clientWidth <= 560;

		let marks: Record<string, Mark> = {};
		let stale = false;
		let me: { lat: number; lng: number } | null = null;
		let current: string | null = null;
		// Раскрытая строка списка: её пин подсвечен на карте, но карточка на карте не открывается — отделение на экране один раз.
		let picked: string | null = null;
		// Перед печатью раскрываются все строки: их toggle не должен двигать карту.
		let printing = false;
		let sheet: 'half' | 'full' = 'half';
		let chooser: { title: string; ids: string[] } | null = null;
		let hint: string | null = null;
		// Карточка, в которой нажали «Отметить очередь»: в ней вместо ряда кнопок — выбор состояния.
		let asking: string | null = null;
		// Карточку или выбор отделения открыла верхняя кнопка «Я стою в очереди»: сразу спрашиваем, какая очередь.
		let fromReport = false;
		let map: any = null;
		let lib: any = null;
		const pins = new Map<string, HTMLButtonElement>();
		const optimistic = new Map<string, Mark | undefined>();
		// Отметка в работе: выбор, таймер отмены и решение PoW — одно на открытую карточку.
		let rep: { id: string; phase: Phase; pick: string; comment: string; error: string; timer: number; pow: Promise<string> | null } | null = null;

		const point = (id: string) => pts.find((p) => p.id === id);
		const sentAt = (id: string) => Number(store.get(`q-sent-${id}`) || 0);

		function hoursOf(p: Pt): Hours {
			const { day, min } = belgradeNow();
			const st = branchStatus(range(p.wd), range(p.sat), day, min);
			if (st.state === 'open') {
				const text = st.left <= 60 ? tx.closesIn.replace('%m', String(st.left)) : tx.openUntil.replace('%t', hhmm(st.closesAt)).replace('%s', dur(st.left));
				return { open: true, text, preOpen: false, reportsAt: '', next: '' };
			}
			if (st.state === 'later') {
				const at = hhmm(st.opensAt);
				return { open: false, text: tx.laterToday.replace('%t', at), preOpen: canReport(st, min), reportsAt: hhmm(reportsFrom(st.opensAt)), next: tx.opensToday.replace('%t', at) };
			}
			const opens = st.opensAt ?? 480;
			const at = hhmm(opens);
			const next = st.tomorrow ? tx.opensTomorrow.replace('%t', at) : tx.opensOn.replace('%d', tx.days[st.nextDay ?? 1]).replace('%t', at);
			const text = st.closedAt === null ? tx.closedOff.replace('%s', next) : tx.closedDay.replace('%t', hhmm(st.closedAt)).replace('%s', next);
			return { open: false, text, preOpen: false, reportsAt: hhmm(reportsFrom(opens)), next };
		}
		// «Точно» решает сервер: двое разных сошлись и хотя бы один был рядом.
		const sure = (m?: Mark) => Boolean(m && !stale && m.sure && m.minutes_ago <= SURE_MINUTES);
		const pinState = (p: Pt) => (!hoursOf(p).open && !marks[p.id] ? 'closed' : marks[p.id]?.state ?? 'unknown');
		// Всё для блока статуса и кнопки отметки — из того же branchStatus, что и строки списка.
		function cardState(p: Pt): Card {
			const { day, min } = belgradeNow();
			const st = branchStatus(range(p.wd), range(p.sat), day, min);
			const { tone, icon } = statusTone(st);
			const mark = canReport(st, min);
			if (st.state === 'open') {
				const sub = st.left <= 60 ? tx.stClosesIn.replace('%m', String(st.left)) : tx.stLeft.replace('%s', dur(st.left));
				return { tone, icon, title: tx.stOpen.replace('%t', hhmm(st.closesAt)), sub, canMark: true, markWhen: '', marksWhen: '', closed: false, later: false, inside: false };
			}
			if (st.state === 'later') {
				const sub = tx.stIn.replace('%s', dur(st.opensAt - min)) + (mark ? ` · ${tx.stDoor}` : '');
				const when = hhmm(reportsFrom(st.opensAt));
				return { tone, icon, title: tx.stLater.replace('%t', hhmm(st.opensAt)), sub, canMark: mark, markWhen: when, marksWhen: when, closed: false, later: true, inside: false };
			}
			const opens = st.opensAt ?? 480;
			const dayWord = st.tomorrow ? tx.tomorrow : tx.onDay.replace('%d', tx.days[st.nextDay ?? 1]);
			const next = st.tomorrow ? tx.opensTomorrow.replace('%t', hhmm(opens)) : tx.opensOn.replace('%d', tx.days[st.nextDay ?? 1]).replace('%t', hhmm(opens));
			// «сегодня до …» после закрытия только путает: сегодняшние часы уже прошли.
			const sub = tx.stNext.replace('%s', next);
			const when = `${hhmm(reportsFrom(opens))} ${dayWord}`;
			return { tone, icon, title: tx.stClosed, sub, canMark: mark, markWhen: when, marksWhen: when, closed: true, later: false, inside: mark };
		}
		const ago = (m: number) => (m >= 60 ? `${Math.floor(m / 60)}${tx.h} ${m % 60}${tx.min.charAt(0)}` : `${m}${tx.min.charAt(0)}`);

		// ---------- пины ----------
		function pinHtml(p: Pt): string {
			const st = pinState(p);
			const m = marks[p.id];
			const icon = st === 'closed' ? LOCK_PATH : BANK_PATH;
			// Капля 32×42, остриё — в нижней точке; иконка внутри SVG, чтобы масштабироваться вместе с каплей.
			return `<svg class="q-drop" viewBox="0 0 32 42" aria-hidden="true"><path class="q-drop-body" d="M16 42C16 42 2.5 26.5 2.5 15.5a13.5 13.5 0 0 1 27 0C29.5 26.5 16 42 16 42z"/><svg x="8" y="7.5" width="16" height="16" viewBox="0 0 24 24"><path class="q-drop-ico" d="${icon}"/></svg></svg>`
				+ (m ? `<span class="q-pin-ago">${esc(ago(m.minutes_ago))}</span>` : '')
				+ `<span class="q-pin-name">${esc(p.name)}</span>`;
		}
		function pinLabel(p: Pt): string {
			const m = marks[p.id];
			const st = pinState(p);
			const what = m ? tx.pinMarks.replace('%s', tx.states[m.state]).replace('%n', nMarks(m.count)).replace('%m', String(m.minutes_ago)) + (sure(m) ? '' : `, ${tx.unsure}`) : st === 'closed' ? tx.pinClosed : tx.pinNone;
			return `${p.name}. ${what}. ${tx.open}`;
		}
		function paintPins() {
			pins.forEach((el, id) => {
				const p = point(id)!;
				// Только data-атрибуты: класс maplibregl-marker (position: absolute) трогать нельзя — иначе пины уплывают.
				el.dataset.q = pinState(p);
				el.dataset.sure = sure(marks[id]) ? '1' : '0';
				const on = id === current || id === picked;
				el.toggleAttribute('data-selected', on);
				el.dataset.dim = passes(id).ok ? '0' : '1';
				el.style.zIndex = on ? '3' : '';
				el.setAttribute('aria-label', pinLabel(p));
				el.innerHTML = pinHtml(p);
			});
		}

		// ---------- список ----------
		// «Свободнее»: сначала отметки посетителей, при равенстве — обычная загрузка Google в этот час.
		function rank(p: Pt): number {
			const m = marks[p.id];
			if (!hoursOf(p).open && !hoursOf(p).preOpen) return 100;
			if (m && sure(m)) return STATES.indexOf(m.state);
			return m ? 10 : 20;
		}
		function busyNow(id: string): number {
			const i = infos.get(id);
			const { day, min } = belgradeNow();
			if (!i || day === 0) return 50;
			return pctAt(i, day === 6 ? 'sat' : 'wd', Math.floor(min / 60)) ?? 50;
		}
		function compare(a: Pt, b: Pt): number {
			const order = radio('f-order');
			const aod = (aodIdx.get(a.id) ?? 0) - (aodIdx.get(b.id) ?? 0);
			if (order === 'near' && me) return distM(me, a) - distM(me, b);
			if (order === 'free') return rank(a) - rank(b) || busyNow(a.id) - busyNow(b.id) || aod;
			return aod;
		}
		// Фильтры размера и часа: null — не проходит; число — процент загрузки в выбранный час (подсветка «свободнее»).
		function passes(id: string): { ok: boolean; free: number | null } {
			const i = infos.get(id);
			if (!i) return { ok: true, free: null };
			const size = radio('f-size'), hour = Number(hourSel.value) || 0;
			if (size && i.size !== size) return { ok: false, free: null };
			if (!hour) return { ok: true, free: null };
			const v = pctAt(i, radio('f-day'), hour);
			if (v === null) return { ok: true, free: null };
			return v < 50 ? { ok: true, free: v } : { ok: false, free: null };
		}
		// Коротко, чтобы влезало в одну строку на 390: «Открыто до 17:00», «Закрыто · откроется в пн в 8:00».
		function rowHours(p: Pt): string {
			const { day, min } = belgradeNow();
			const st = branchStatus(range(p.wd), range(p.sat), day, min);
			if (st.state === 'open') return st.left <= 60 ? tx.closesIn.replace('%m', String(st.left)) : tx.stOpen.replace('%t', hhmm(st.closesAt));
			if (st.state === 'later') return tx.laterToday.replace('%t', hhmm(st.opensAt));
			const next = tx.stNext.replace('%s', hoursOf(p).next);
			return `${tx.stClosed} · ${next.charAt(0).toLowerCase()}${next.slice(1)}`;
		}
		// Свёрнутая строка: значок очереди, название, «открыто до …» / «закрыто, откроется …», адрес.
		function paintRow(i: Info, p: Pt, free: number | null) {
			const m = marks[p.id];
			const st = pinState(p);
			const dot = i.el.querySelector<HTMLElement>('.q-dot')!;
			dot.dataset.q = st;
			dot.dataset.sure = sure(m) ? '1' : '0';
			dot.innerHTML = GLYPH[st] ?? '';
			const verdict = m ? `${tx.states[m.state]} · ${nMarks(m.count)}, ${m.minutes_ago} ${tx.min}${sure(m) ? '' : ` — ${tx.unsure}`} · ` : '';
			i.el.querySelector('.bl-status')!.textContent = verdict + rowHours(p);
			i.el.querySelector('.bl-far')!.textContent = me ? distText(distM(me, p)) : '';
			const on = p.id === current || p.id === picked;
			i.el.classList.toggle('is-selected', on);
			i.el.classList.toggle('f-hl', free !== null);
			const fr = i.el.querySelector<HTMLElement>('.f-free')!;
			fr.hidden = free === null;
			fr.textContent = free === null ? '' : box.dataset.free!.replace('%p', String(free));
		}
		// Узлы переставляем, только если порядок изменился: иначе каждое обновление сбивало бы фокус в строке.
		function place(parent: HTMLElement, items: HTMLElement[]) {
			const now = [...parent.children];
			if (now.length === items.length && now.every((el, k) => el === items[k])) return;
			parent.replaceChildren(...items);
		}
		function setB(id: string | null) {
			const url = new URL(location.href);
			if (id) url.searchParams.set('b', id); else url.searchParams.delete('b');
			history.replaceState(history.state, '', url);
		}
		// Один список: открытые сейчас сверху, закрытые — свёрнутой группой в конце; если закрыты все — одна строка вместо них.
		function renderLists() {
			const hour = Number(hourSel.value) || 0;
			const open: Pt[] = [], closed: Pt[] = [];
			let shown = 0, total = 0;
			infos.forEach((i, id) => {
				const p = point(id)!;
				const city = inCity(p);
				const { ok, free } = passes(id);
				if (city) { total += 1; if (ok) shown += 1; }
				const visible = (city && ok) || id === current || id === picked;
				i.li.hidden = !visible;
				paintRow(i, p, free);
				if (visible) (rank(p) < 100 ? open : closed).push(p);
			});
			open.sort(compare);
			closed.sort(compare);
			place(live, open.map((p) => infos.get(p.id)!.li));
			place(closedRows, closed.map((p) => infos.get(p.id)!.li));
			live.hidden = !open.length;
			closedBox.hidden = !closed.length;
			const sum = closedBox.querySelector('.bl-closed-sum')!;
			sum.textContent = open.length || !closed.length ? `${tx.closedNow} (${closed.length})` : `${tx.allClosed.replace('%s', hoursOf(closed[0]).next)} (${closed.length})`;
			closedBox.classList.toggle('bl-all', !open.length);
			if (picked && closed.some((p) => p.id === picked)) closedBox.open = true;
			listBox.querySelector('.bl-count')!.textContent = box.dataset.shown!.replace('%n', String(shown)).replace('%m', String(total));
			box.querySelector<HTMLElement>('.f-note')!.hidden = !hour;
			const rows = pts.filter(inCity);
			const n = rows.reduce((s, p) => s + (marks[p.id]?.count ?? 0), 0);
			const b = rows.filter((p) => marks[p.id]).length;
			$('.q-scale').textContent = n < 10 ? tx.scaleInvite : tx.scale.replace('%n', nMarks(n)).replace('%m', `${b} ${form(b, tx.branches)}`);
			const anyOpen = pts.some((x) => { const h = hoursOf(x); return h.open || h.preOpen; });
			reportBtn.dataset.closed = anyOpen ? '0' : '1';
			if (anyOpen) reportBtn.removeAttribute('aria-describedby'); else reportBtn.setAttribute('aria-describedby', 'q-msg');
			box.querySelector<HTMLElement>('.bc-near')!.hidden = !me;
		}
		// Раскрыли строку: пин подсвечен и в центре карты, ?b= запомнен; открытая карточка другого отделения закрывается.
		function pickRow(id: string) {
			if (current) closeCard(false);
			picked = id;
			setB(id);
			paintPins();
			renderLists();
			const p = point(id);
			if (p && map) map.easeTo({ center: [p.lng, p.lat], zoom: Math.max(map.getZoom(), 15), duration: reduced() ? 0 : 500 });
		}
		function unpickRow(id: string) {
			if (picked !== id) return;
			picked = null;
			if (!current) setB(null);
			paintPins();
			renderLists();
		}

		// ---------- карточка ----------
		function reportBlock(p: Pt): string {
			const since = nowMs() - sentAt(p.id);
			const r = rep?.id === p.id ? rep : null;
			if (r?.phase === 'done' || ((!r || r.phase === 'idle') && since < REPEAT_MS)) {
				const left = Math.max(REPEAT_MS - since, 0);
				const mmss = `${Math.floor(left / 60000)}:${pad(Math.floor((left % 60000) / 1000))}`;
				const top = r?.phase === 'done'
					? `<p><strong>✓ ${esc(tx.thanks)}</strong></p><p>${esc(tx.seen.replace('%s', p.cityName))}</p>`
					: `<p><strong>✓ ${esc(tx.marked.replace('%m', String(Math.floor(since / 60000))))}</strong></p>`;
				return `<div class="q-done" aria-live="polite">${top}<p class="q-again">${esc(tx.again.replace('%s', mmss))}</p></div>`;
			}
			if (r?.phase === 'limit') return `<p class="q-limit" aria-live="polite">${esc(r.error)}</p>`;
			if (r && (r.phase === 'pending' || r.phase === 'hold' || r.phase === 'sending')) {
				const mic = voiceSupported ? `<button type="button" class="q-mic" hidden><span>${esc(tx.voice.start)}</span></button>` : '';
				return `<div class="q-undo" aria-live="polite">
					<p class="q-undo-what">${esc(tx.sending.replace('%s', tx.states[r.pick]))}${reduced() ? ` · ${esc(tx.inSec)}` : ''}</p>
					<div class="q-undo-row"><span class="q-bar"><i data-run="${r.phase === 'pending' ? 1 : 0}"></i></span><button type="button" class="q-cancel">${esc(tx.cancel)}</button></div>
					<div class="q-comment-row"><input type="text" class="q-comment" maxlength="140" placeholder="${esc(tx.comment)}" aria-label="${esc(tx.comment)}" value="${esc(r.comment)}">${mic}</div>
					<p class="q-comment-note">${esc(tx.commentNote)}</p><p class="q-voice-status"></p>
					${r.phase === 'hold' ? `<button type="button" class="q-send">${esc(tx.send)}</button>` : ''}
				</div>`;
			}
			const ask = since < REPEAT_MS * 8 && sentAt(p.id) ? tx.askAgain : tx.ask;
			const picks = STATES.map((k) => `<button type="button" class="q-pick" data-state="${k}"${r?.pick === k ? ' aria-pressed="true"' : ''}>${GLYPH[k]}<span class="q-long">${esc(tx.states[k])}</span><span class="q-short">${esc(tx.short[k])}</span></button>`).join('');
			const err = r?.phase === 'error' ? `<p class="q-err" role="alert">${esc(r.error)}</p>` : '';
			return `<p class="q-ask">${esc(ask)}</p><div class="q-picks">${picks}</div>${err}<button type="button" class="q-ask-cancel">${esc(tx.cancel)}</button>`;
		}
		function chooserHtml(): string {
			const rows = chooser!.ids.map((id) => {
				const p = point(id)!;
				const far = me ? `<em>${distText(distM(me, p))}</em>` : '';
				return `<li><button type="button" data-id="${id}"><span><strong>${esc(p.name)}</strong>${far}<small>${esc(p.addr)}</small></span></button></li>`;
			}).join('');
			return `${head(chooser!.title)}<div class="q-card-body"><ul class="q-rows q-choose">${rows}</ul></div>`;
		}
		function head(title: string, addr = ''): string {
			const toggle = `<button type="button" class="q-grip" aria-label="${esc(sheet === 'full' ? tx.collapse : tx.expand)}"><i></i></button>`;
			const back = chooser ? `<button type="button" class="q-back">${esc(tx.back)}</button>` : '';
			const sub = addr ? `<p class="q-addr">${esc(addr)}</p>` : '';
			return `<div class="q-card-head">${toggle}${back}<div class="q-title"><h3 tabindex="-1">${esc(title)}</h3>${sub}</div><button type="button" class="q-x" aria-label="${esc(tx.close)}">${ICON('x')}</button></div>`;
		}
		// Адрес без почтового индекса: «Vase Čarapića 18, Beograd».
		const shortAddr = (addr: string) => addr.replace(/,\s*\d{5}\s+/, ', ');
		function cardHtml(p: Pt): string {
			const c = cardState(p);
			const far = me ? distM(me, p) : null;
			const near = hint ?? '';
			const staleLine = stale ? `<p class="q-stale">${ICON('alert')}<span>${esc(note.textContent ?? '')}</span></p>` : '';
			const google = p.chart ? `<details class="q-acc q-google"><summary>${ICON('chart')}<span>${esc(tx.googleSum)}</span>${ICON('chevron')}</summary>${p.chart}<p class="q-google-note">${esc(tx.googleNote)}</p></details>` : '';
			const code = `${tx.code} ${p.code}`;
			const tag = p.tag ? `<div class="q-tag"><p class="q-tag-t">${esc(tx.special)}</p><p class="q-tag-o" lang="sr-Latn">${esc(p.tag)}</p><p class="q-tag-n">${esc(tx.unclear)}</p></div>` : '';
			return `${head(p.name, `${shortAddr(p.addr)} · ${code}`)}<div class="q-card-body">
				${tag}
				${staleLine}
				${near ? `<p class="q-near">${near}</p>` : ''}
				${far !== null ? `<p class="q-far">${esc(tx.far.replace('%s', distText(far)))}</p>` : ''}
				${p.note ? `<p class="q-muted">${esc(p.note)}</p>` : ''}
				<div class="q-status" data-tone="${c.tone}" role="status"><span class="q-status-ic">${ICON(c.icon)}</span><div><p class="q-status-t">${esc(c.title)}</p><p class="q-status-s">${esc(c.sub)}</p></div></div>
				${verdictHtml(p)}
				<div class="q-block q-full-only"><div class="q-block-head"><span class="q-block-ic">${ICON('clock')}</span><p class="q-lbl">${esc(tx.hLabel)}</p></div>${weekHtml(p)}</div>
				<div class="q-report-box">${actionsHtml(p, c)}</div>
				<div class="q-full-only q-more">${google}
				<p class="q-foot">${ICON('info')}<span>${esc(tx.foot)} <button type="button" class="q-legend-link">${esc(tx.legend)}</button></span></p></div>
			</div>`;
		}
		function weekHtml(p: Pt): string {
			const tiles = weekTiles(range(p.wd), range(p.sat), belgradeNow().day).map((d) => {
				const name = tx.days[d.day].charAt(0).toUpperCase() + tx.days[d.day].slice(1);
				return `<li class="q-day"${d.today ? ' data-today' : ''}${d.hours ? '' : ' data-off'}><b>${esc(name)}</b><span>${d.hours ?? '—'}</span></li>`;
			}).join('');
			return `<ul class="q-week">${tiles}</ul>`;
		}
		// Ряд «Маршрут | Отметить очередь»; после нажатия отметки на его месте — выбор состояния и таймер.
		function actionsHtml(p: Pt, c: Card): string {
			const route = p.gmaps || `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;
			const routeBtn = `<a class="q-route" href="${esc(route)}" target="_blank" rel="noopener">${GM_PIN}<span>${esc(tx.route)}</span><span class="sr-only"> (${esc(tx.newTab)})</span></a>`;
			const r = rep?.id === p.id ? rep : null;
			const recent = nowMs() - sentAt(p.id) < REPEAT_MS;
			if (c.canMark && (asking === p.id || (r && r.phase !== 'idle') || recent)) {
				return `${reportBlock(p)}<div class="q-actions q-actions-1">${routeBtn}</div>`;
			}
			const off = c.canMark ? '' : ' disabled aria-disabled="true"';
			const line = c.inside ? tx.markInside : c.canMark ? tx.markHint : tx.markFrom.replace('%t', c.markWhen.split(' ')[0]).replace('%s', c.later ? '' : c.markWhen.split(' ').slice(1).join(' ')).trim();
			return `<div class="q-actions">${routeBtn}<button type="button" class="q-mark"${off}>${ICON('plus')}<span>${esc(tx.mark)}</span></button></div><p class="q-mark-note">${esc(line)}</p>`;
		}
		function verdictHtml(p: Pt): string {
			const m = marks[p.id];
			const c = cardState(p);
			const ok = sure(m);
			let title = tx.qNone, sub = '';
			if (m) {
				title = tx.states[m.state];
				if (c.later) {
					const t = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Belgrade', hour: 'numeric', minute: '2-digit', hourCycle: 'h23' }).format(new Date(nowMs() - m.minutes_ago * 60000));
					sub = tx.qDoor.replace('%n', nMarks(m.count)).replace('%t', t);
				} else sub = (ok ? tx.qSure : tx.qAgo).replace('%n', nMarks(m.count)).replace('%m', String(m.minutes_ago));
				if (!ok) sub += ` · ${tx.unsure}`;
			} else sub = c.closed && !c.canMark ? tx.qFrom.replace('%t', c.marksWhen.split(' ')[0]).replace('%s', c.marksWhen.split(' ').slice(1).join(' ')).trim() : tx.qNobody;
			const level = m ? queueLevel(m.state) : 0;
			const segs = QUEUE_LEVELS.map((k, i) => `<i data-q="${k}"${i < level ? ' data-on' : ''}></i>`).join('');
			return `<div class="q-block q-queue" data-sure="${ok ? 1 : 0}"><div class="q-block-head"><span class="q-block-ic">${ICON('users')}</span><div class="q-block-txt"><p class="q-lbl">${esc(tx.qLabel)}</p>
				<p class="q-verdict">${esc(title)}</p><p class="q-trust">${esc(sub)}</p></div></div>
				<div class="q-meter" aria-hidden="true">${segs}</div><p class="q-meter-lbl" aria-hidden="true"><span>${esc(tx.qFree)}</span><span>${esc(tx.qOut)}</span></p></div>`;
		}
		function updateVerdict() {
			const v = card.querySelector('.q-queue');
			if (!v || !current) return;
			v.outerHTML = verdictHtml(point(current)!);
		}
		function render(focus = false) {
			if (!current && !chooser) {
				card.hidden = true;
				root.removeAttribute('data-card');
				stub.hidden = !narrow();
				return;
			}
			card.hidden = false;
			stub.hidden = true;
			root.dataset.card = sheet;
			card.innerHTML = chooser ? chooserHtml() : cardHtml(point(current!)!);
			wireCard();
			if (focus) card.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
		}
		// Перерисовать только блок отметки: поле комментария и микрофон при этом живут, пока идёт таймер.
		function renderReport() {
			if (!current) return;
			const box = card.querySelector<HTMLElement>('.q-report-box');
			if (!box) return render();
			box.innerHTML = actionsHtml(point(current)!, cardState(point(current)!));
			wireCard();
		}
		function wireCard() {
			const bar = card.querySelector<HTMLElement>('.q-bar i[data-run="1"]');
			if (bar && !reduced()) requestAnimationFrame(() => requestAnimationFrame(() => bar.classList.add('go')));
			const input = card.querySelector<HTMLInputElement>('.q-comment');
			const mic = card.querySelector<HTMLButtonElement>('.q-mic');
			if (input && mic && rep) {
				attachVoice({ button: mic, label: mic.querySelector('span'), status: card.querySelector('.q-voice-status'), box: input, lang: root.dataset.voiceLang ?? 'ru-RU', texts: tx.voice, onStart: hold });
			}
		}

		function easeToPin(p: Pt) {
			if (!map) return;
			const bottom = narrow() ? card.getBoundingClientRect().height : 0;
			// Сдвиг вместо padding: padding в MapLibre копится между вызовами, а нужен ровно центр видимой над листом части.
			map.easeTo({ center: [p.lng, p.lat], zoom: Math.max(map.getZoom(), 15), offset: [0, -bottom / 2 + 20], duration: reduced() ? 0 : 500 });
		}
		function openCard(id: string, opts: { focus?: boolean; hint?: string; ask?: boolean } = {}) {
			const p = point(id);
			if (!p) return;
			if (rep && rep.id !== id && rep.phase !== 'done') flush();
			const ask = opts.ask ?? (fromReport && chooser !== null);
			fromReport = false;
			// Карточка и раскрытая строка с тем же содержимым одновременно не показываются.
			if (picked) { const was = infos.get(picked)?.el; picked = null; if (was) was.open = false; }
			current = id;
			chooser = null;
			hint = opts.hint ?? null;
			if (asking !== id) asking = null;
			if (ask && cardState(p).canMark) { asking = id; if (narrow()) sheet = 'full'; }
			if (citySel.value !== p.city) { citySel.value = p.city; store.set('q-city', p.city); fitCity(); }
			setB(id);
			if (!rep || rep.id !== id) rep = { id, phase: 'idle', pick: '', comment: '', error: '', timer: 0, pow: null };
			// Задачу от ботов решаем сразу, пока человек читает карточку, — тап по варианту не ждёт.
			if (!rep.pow) { rep.pow = solvePow(); rep.pow.catch(() => { if (rep) rep.pow = null; }); }
			paintPins();
			renderLists();
			render(opts.focus !== false);
			easeToPin(p);
			// На телефоне карта с карточкой ниже верхней кнопки: без прокрутки выбор состояния оказывается за экраном.
			if (ask) showCard();
		}
		function showCard() {
			const target = narrow() ? card : card.querySelector<HTMLElement>('.q-report-box') ?? card;
			target.scrollIntoView({ block: narrow() ? 'end' : 'nearest', behavior: reduced() ? 'auto' : 'smooth' });
			// Внутри листа выбор состояния — под статусом и часами: прокручиваем лист к нему.
			const box = card.querySelector<HTMLElement>('.q-report-box');
			if (box) card.scrollTop += box.getBoundingClientRect().bottom - card.getBoundingClientRect().bottom + 16;
		}
		function openChooser(title: string, ids: string[], ask = false) {
			current = null;
			chooser = { title, ids };
			fromReport = ask;
			sheet = 'half';
			paintPins();
			render(true);
			if (ask) showCard();
		}
		function closeCard(refocus = true) {
			const was = current;
			if (rep && rep.phase !== 'done') flush();
			current = null;
			fromReport = false;
			chooser = null;
			hint = null;
			asking = null;
			sheet = 'half';
			if (was) setB(null);
			paintPins();
			renderLists();
			render();
			if (!refocus) return;
			const back = returnTo ?? (was ? (narrow() ? pins.get(was) : infos.get(was)?.el.querySelector<HTMLElement>('summary')) : null);
			returnTo = null;
			back?.focus({ preventScroll: true });
		}
		function setSheet(pos: 'half' | 'full') {
			sheet = pos;
			root.dataset.card = pos;
			const grip = card.querySelector('.q-grip');
			grip?.setAttribute('aria-label', pos === 'full' ? tx.collapse : tx.expand);
			const p = current ? point(current) : null;
			if (p) window.setTimeout(() => easeToPin(p), reduced() ? 0 : 260);
		}

		// ---------- отметка ----------
		function choose(state: string) {
			if (!rep || !current) return;
			window.clearTimeout(rep.timer);
			const p = point(current)!;
			if (CONTACT.test(rep.comment)) { rep.phase = 'error'; rep.error = tx.badComment; return renderReport(); }
			rep.pick = state;
			rep.phase = 'pending';
			// Пин перекрашиваем сразу, при ошибке вернём как было.
			if (!optimistic.has(p.id)) optimistic.set(p.id, marks[p.id]);
			const was = optimistic.get(p.id);
			marks[p.id] = { state, count: (was?.count ?? 0) + 1, minutes_ago: 0 };
			paintPins();
			renderLists();
			updateVerdict();
			renderReport();
			rep.timer = window.setTimeout(send, UNDO_MS);
		}
		function hold() {
			if (!rep || rep.phase !== 'pending') return;
			window.clearTimeout(rep.timer);
			rep.phase = 'hold';
			const bar = card.querySelector<HTMLElement>('.q-bar i');
			bar?.classList.remove('go');
			bar?.setAttribute('data-run', '0');
			if (!card.querySelector('.q-send')) card.querySelector('.q-undo')?.insertAdjacentHTML('beforeend', `<button type="button" class="q-send">${esc(tx.send)}</button>`);
		}
		function rollback(id: string) {
			if (!optimistic.has(id)) return;
			const was = optimistic.get(id);
			if (was) marks[id] = was; else delete marks[id];
			optimistic.delete(id);
			paintPins();
			renderLists();
			updateVerdict();
		}
		function cancel() {
			if (!rep) return;
			window.clearTimeout(rep.timer);
			rollback(rep.id);
			rep.phase = 'idle';
			rep.pick = '';
			asking = null;
			renderReport();
		}
		// Уход со страницы во время таймера: отправляем сразу, keepalive доносит запрос после закрытия вкладки.
		function flush() {
			if (!rep || (rep.phase !== 'pending' && rep.phase !== 'hold')) return;
			window.clearTimeout(rep.timer);
			void send(true);
		}
		async function send(leaving = false) {
			const r = rep;
			if (!r || !r.pick) return;
			window.clearTimeout(r.timer);
			r.phase = 'sending';
			const id = r.id;
			let altcha = '';
			try { altcha = r.pow ? await r.pow : await solvePow(); } catch { /* сервер ответит 400, покажем ошибку сети */ }
			const where = me ?? (leaving ? null : await grantedPosition());
			let status = 0, body: any = {};
			try {
				const res = await fetch('/api/queue', {
					method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ branch_id: id, state: r.pick, comment: r.comment, altcha, device_id: deviceId(), ...(where ?? {}) }),
				});
				status = res.status;
				body = await res.json().catch(() => ({}));
			} catch { /* сеть */ }
			if (leaving) return;
			r.pow = null;
			if (status === 201) {
				store.set(`q-sent-${id}`, String(nowMs()));
				optimistic.delete(id);
				r.phase = 'done';
				window.setTimeout(() => void refresh(), 31000);
			} else {
				rollback(id);
				r.pow = solvePow();
				r.pow.catch(() => { r.pow = null; });
				if (status === 403 && body.error === 'closed') {
					// Сервер решает по своим часам: на телефоне со сбитым временем кнопка могла оказаться активной.
					const when = body.days_ahead === 0 ? '' : body.days_ahead === 1 ? tx.tomorrow : tx.onDay.replace('%d', tx.days[(Number(body.weekday) + 1) % 7]);
					r.phase = 'limit';
					r.error = tx.markFrom.replace('%t', String(body.reports_from)).replace('%s', when).trim();
				} else if (status === 429) {
					r.phase = body.scope === 'ip' ? 'error' : 'limit';
					if (body.scope === 'ip') r.error = tx.limitIp;
					else {
						const at = sentAt(id) || nowMs();
						const left = Math.max(1, Math.ceil((REPEAT_MS - (nowMs() - at)) / 60000));
						const t = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Belgrade', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(at));
						r.error = tx.limitBranch.replace('%t', t).replace('%m', String(left));
					}
				} else if (String(body.error ?? '').startsWith('comment')) { r.phase = 'error'; r.error = tx.badComment; }
				else { r.phase = 'error'; r.error = tx.netError; }
			}
			if (current === id) renderReport();
		}

		// ---------- данные ----------
		async function refresh() {
			try {
				const res = await fetch('/api/queue');
				if (!res.ok) throw new Error(String(res.status));
				const body = await res.json();
				offset = clockOffset(body.now, Number(res.headers.get('age')) || 0, Date.now());
				const fresh = body.branches ?? {};
				optimistic.forEach((_, id) => { if (marks[id]) fresh[id] = marks[id]; });
				marks = fresh;
				stale = false;
				note.hidden = true;
				store.set('q-updated', String(nowMs()));
			} catch {
				// Отметки оставляем, но все пины — «не точно», и говорим, на какое время данные.
				stale = true;
				const at = Number(store.get('q-updated')) || nowMs();
				note.textContent = tx.stale.replace('%t', new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Belgrade', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(at)));
				note.hidden = false;
			}
			paintPins();
			renderLists();
			if (current && (!rep || rep.phase === 'idle' || rep.phase === 'done' || rep.phase === 'limit')) render();
		}

		// ---------- геолокация ----------
		function locate() {
			const text = reportBtn.querySelector('.q-report-text')!;
			// Все отделения закрыты: геолокацию не просим, а объясняем, почему отметка недоступна и когда она откроется.
			const open = pts.map(hoursOf);
			if (!open.some((h) => h.open || h.preOpen)) {
				const h = open[0];
				msg.textContent = tx.closedAll.replace('%t', h.reportsAt).replace('%s', h.next);
				return;
			}
			let settled = false;
			let giveUp = 0;
			const done = () => { settled = true; window.clearTimeout(giveUp); text.textContent = tx.report; reportBtn.removeAttribute('aria-busy'); };
			const fallback = () => {
				if (settled && !reportBtn.hasAttribute('aria-busy')) return;
				done();
				msg.textContent = tx.geoOff;
				const ids = pts.filter(inCity).sort((a, b) => a.name.localeCompare(b.name)).map((p) => p.id);
				openChooser(tx.noGeo, ids, true);
			};
			if (!navigator.geolocation) return fallback();
			text.textContent = tx.finding;
			reportBtn.setAttribute('aria-busy', 'true');
			// Браузер может не ответить вовсе (запрос разрешения закрыт, не отвечает служба) — тогда не молчим, а даём список.
			giveUp = window.setTimeout(fallback, GEO_GIVE_UP_MS);
			navigator.geolocation.getCurrentPosition(
				(pos) => {
					if (!reportBtn.hasAttribute('aria-busy')) return;
					done();
					msg.textContent = '';
					try {
						me = { lat: pos.coords.latitude, lng: pos.coords.longitude };
						setRadio('f-order', 'near');
						const near = [...pts].sort((a, b) => distM(me!, a) - distM(me!, b));
						const limit = Math.max(GEO_MIN_M, pos.coords.accuracy || 0);
						const d0 = distM(me, near[0]);
						const d1 = near[1] ? distM(me, near[1]) : Infinity;
						renderLists();
						if (d0 <= limit && d1 > GEO_SECOND_M && pos.coords.accuracy <= GEO_MIN_M) {
							openCard(near[0].id, { ask: true, hint: `${esc(tx.nearYou.replace('%s', distText(d0)))} <button type="button" class="q-other">${esc(tx.other)}</button>` });
						} else openChooser(tx.which, near.slice(0, 3).map((p) => p.id), true);
					} catch {
						settled = false;
						reportBtn.setAttribute('aria-busy', 'true');
						fallback();
					}
				},
				fallback,
				{ enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 },
			);
		}

		// ---------- панель фильтров и события ----------
		// Карта не поднялась — вместо неё запасной список отделений с отметкой (сценарий П13).
		function showFallback() {
			canvas.hidden = true;
		}
		citySel.addEventListener('change', () => {
			store.set('q-city', citySel.value);
			if (current) closeCard();
			renderLists();
			paintPins();
			fitCity();
		});
		box.addEventListener('change', (ev) => {
			if (ev.target === citySel) return;
			renderLists();
			paintPins();
		});
		box.querySelector('.f-reset')!.addEventListener('click', () => {
			hourSel.selectedIndex = 0;
			setRadio('f-day', 'wd');
			setRadio('f-size', '');
			setRadio('f-order', 'free');
			renderLists();
			paintPins();
		});
		// «На карте» в строке: без JS — ссылка на блок карты с ?b=, с JS — подсветить пин на нашей карте, строка остаётся раскрытой.
		document.addEventListener('click', (ev) => {
			const link = (ev.target as HTMLElement).closest<HTMLAnchorElement>('[data-show]');
			if (!link || ev.defaultPrevented || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
			ev.preventDefault();
			const id = link.dataset.show!;
			if (picked !== id) pickRow(id);
			else { const p = point(id); if (p && map) map.easeTo({ center: [p.lng, p.lat], zoom: Math.max(map.getZoom(), 15), duration: reduced() ? 0 : 500 }); }
			$('.qmap-view').scrollIntoView({ block: narrow() ? 'start' : 'nearest', behavior: reduced() ? 'auto' : 'smooth' });
			pins.get(id)?.focus({ preventScroll: true });
		});
		// «Отметить» в строке открывает карточку сразу на выборе состояния — отметка живёт только в карточке.
		listBox.addEventListener('click', (ev) => {
			const mk = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-mark]');
			if (!mk) return;
			returnTo = mk.closest('details')?.querySelector('summary') ?? null;
			openCard(mk.dataset.mark!, { ask: true });
			showCard();
		});
		listBox.addEventListener('toggle', (ev) => {
			const d = ev.target as HTMLDetailsElement;
			if (printing || !d.classList?.contains('bl-row')) return;
			if (d.open) pickRow(d.dataset.branch!); else unpickRow(d.dataset.branch!);
		}, true);
		reportBtn.addEventListener('click', locate);
		stub.addEventListener('click', () => listBox.scrollIntoView({ block: 'start', behavior: reduced() ? 'auto' : 'smooth' }));
		root.addEventListener('click', (ev) => {
			const t = ev.target as HTMLElement;
			const row = t.closest<HTMLButtonElement>('.q-rows button[data-id]');
			if (row) return openCard(row.dataset.id!);
			if (t.closest('.q-x')) return closeCard();
			if (t.closest('.q-back')) return closeCard();
			if (t.closest('.q-grip')) return setSheet(sheet === 'full' ? 'half' : 'full');
			if (t.closest('.q-other')) return openChooser(tx.which, [...pts].sort((a, b) => distM(me!, a) - distM(me!, b)).slice(0, 3).map((p) => p.id), true);
			const mk = t.closest<HTMLButtonElement>('.q-mark');
			if (mk) { if (mk.disabled || !current) return; asking = current; if (narrow()) sheet = 'full'; return render(); }
			if (t.closest('.q-ask-cancel')) { asking = null; if (rep?.phase === 'error') rep.phase = 'idle'; return renderReport(); }
			if (t.closest('.q-legend-link')) {
				const lg = root.querySelector<HTMLDetailsElement>('.qmap-legend');
				if (lg) { lg.open = true; lg.scrollIntoView({ block: 'nearest', behavior: reduced() ? 'auto' : 'smooth' }); }
				return;
			}
			const pick = t.closest<HTMLButtonElement>('.q-pick');
			if (pick) return choose(pick.dataset.state!);
			if (t.closest('.q-cancel')) return cancel();
			if (t.closest('.q-send')) {
				if (rep && CONTACT.test(rep.comment)) { cancel(); rep.phase = 'error'; rep.error = tx.badComment; return renderReport(); }
				return void send();
			}
		});
		root.addEventListener('input', (ev) => {
			const t = ev.target as HTMLInputElement;
			if (t.classList.contains('q-comment') && rep) rep.comment = t.value;
		});
		root.addEventListener('focusin', (ev) => { if ((ev.target as HTMLElement).classList.contains('q-comment')) hold(); });
		// Esc с любого места страницы: карточка, открытая по ссылке ?b=, фокуса не получает.
		document.addEventListener('keydown', (ev) => {
			if (ev.key !== 'Escape') return;
			const more = box.querySelector<HTMLDetailsElement>('.bc-more');
			if (more?.open) { more.open = false; more.querySelector('summary')?.focus(); return; }
			if (current || chooser) closeCard();
		});
		// «Ещё» — выпадающая панель над картой: закрывается кликом мимо неё.
		document.addEventListener('click', (ev) => {
			const more = box.querySelector<HTMLDetailsElement>('.bc-more');
			if (more?.open && !more.contains(ev.target as Node)) more.open = false;
		});
		window.addEventListener('beforeprint', () => { printing = true; });
		window.addEventListener('afterprint', () => window.setTimeout(() => { printing = false; }, 200));
		window.addEventListener('pagehide', flush);
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'hidden') flush();
			else void refresh();
		});

		// Лист тянется за шапку: вверх — «полностью», вниз — «кратко», из «кратко» вниз — закрыть.
		let dragY: number | null = null;
		card.addEventListener('pointerdown', (ev) => {
			if (!narrow() || !(ev.target as HTMLElement).closest('.q-card-head')) return;
			dragY = ev.clientY;
		});
		window.addEventListener('pointerup', (ev) => {
			if (dragY === null) return;
			const dy = ev.clientY - dragY;
			dragY = null;
			if (dy < -40) setSheet('full');
			else if (dy > 40) (sheet === 'full' ? setSheet('half') : closeCard());
		});

		// ---------- карта ----------
		function fitCity() {
			if (!map || !lib) return;
			const rows = pts.filter(inCity);
			if (!rows.length) return;
			const b = new lib.LngLatBounds();
			rows.forEach((p) => b.extend([p.lng, p.lat]));
			map.fitBounds(b, { padding: 50, maxZoom: 14, duration: 0 });
		}
		function noMap() {
			root.dataset.nomap = '';
			msg.textContent = tx.noMap;
			showFallback();
		}
		async function startMap() {
			if (!hasWebGL()) return noMap();
			try {
				lib = await loadLib();
			} catch {
				return noMap();
			}
			lib.addProtocol('pmtiles', new (window as any).pmtiles.Protocol().tile);
			try {
				map = new lib.Map({
					container: canvas, style: root.dataset.style, center: [20.46, 44.81], zoom: 11, maxZoom: 17,
					attributionControl: false, cooperativeGestures: true,
					locale: { 'CooperativeGesturesHandler.WindowsHelpText': tx.coop.windowsHelpText, 'CooperativeGesturesHandler.MacHelpText': tx.coop.macHelpText, 'CooperativeGesturesHandler.MobileHelpText': tx.coop.mobileHelpText },
				});
			} catch {
				return noMap();
			}
			canvas.querySelector('.qmap-loading')?.remove();
			map.addControl(new lib.NavigationControl({ showCompass: false }), 'top-right');
			map.addControl(new lib.GeolocateControl({ positionOptions: { enableHighAccuracy: true } }), 'top-right');
			map.addControl(new lib.ScaleControl({ unit: 'metric' }), 'bottom-right');
			map.addControl(new lib.AttributionControl({ compact: false }), 'bottom-left');
			for (const p of pts) {
				const el = document.createElement('button');
				el.type = 'button';
				el.classList.add('q-pin');
				el.addEventListener('click', (ev) => { ev.stopPropagation(); openCard(p.id, { focus: false }); });
				// anchor 'bottom': остриё капли — нижняя середина элемента — стоит ровно на координате.
				new lib.Marker({ element: el, anchor: 'bottom' }).setLngLat([p.lng, p.lat]).addTo(map);
				pins.set(p.id, el);
			}
			const near = () => root.toggleAttribute('data-near', map.getZoom() >= 15);
			map.on('zoom', near);
			map.on('click', (e: any) => { if (!(e.originalEvent?.target as HTMLElement)?.closest?.('.q-pin') && current) closeCard(); });
			// Открытая по ссылке ?b= карточка важнее обзора города.
			map.on('load', () => (current ? easeToPin(point(current)!) : picked ? pickRow(picked) : fitCity()));
			fitCity();
			near();
			paintPins();
			if (current) easeToPin(point(current)!);
		}

		// ---------- старт ----------
		box.hidden = false;
		listBox.classList.add('bl-js');
		listBox.querySelectorAll<HTMLElement>('.bl-mark').forEach((b) => (b.hidden = false));
		// Приоритет города: ?b= > якорь города в адресе > сохранённый город > Белград.
		const has = (v: string | null) => v !== null && [...citySel.options].some((o) => o.value === v);
		const savedCity = store.get('q-city');
		const cityFromHash = () => document.querySelector<HTMLElement>(`.bl-city#${CSS.escape(location.hash.slice(1) || '-')}`)?.dataset.city ?? null;
		const anchorCity = cityFromHash();
		// Ссылка на город (#branches-nis, в том числе старая #otdeleniya-nis после anchor-redirect.js) выбирает город в фильтре.
		const followHash = () => {
			const c = cityFromHash();
			if (!has(c) || citySel.value === c) return;
			citySel.value = c!;
			store.set('q-city', c!);
			if (current) closeCard(false);
			renderLists();
			paintPins();
			fitCity();
			listBox.scrollIntoView({ block: 'start' });
		};
		window.addEventListener('hashchange', followHash);
		window.addEventListener('anchor-redirect', followHash);
		if (has(anchorCity)) citySel.value = anchorCity!;
		else if (has(savedCity)) citySel.value = savedCity!;
		renderLists();
		render();
		const wanted = new URLSearchParams(location.search).get('b');
		if (wanted && point(wanted)) openCard(wanted, { focus: false });
		let started = false;
		const io = new IntersectionObserver((entries) => {
			if (started || !entries.some((e) => e.isIntersecting)) return;
			started = true;
			io.disconnect();
			void refresh();
			window.setInterval(() => { if (document.visibilityState === 'visible') void refresh(); }, POLL_MS);
			void startMap();
		}, { rootMargin: '400px' });
		io.observe(root);
		// Широкий блок заходит на колонку оглавления — пока он на экране, оглавление прячем (CSS: data-qmap-wide).
		new IntersectionObserver((entries) => {
			document.documentElement.toggleAttribute('data-qmap-wide', entries.some((e) => e.isIntersecting));
		}).observe(root);
		// Таймер «обновить можно через мм:сс» в открытой карточке.
		window.setInterval(() => {
			const again = card.querySelector('.q-again');
			if (!again || !current) return;
			if (nowMs() - sentAt(current) >= REPEAT_MS) { if (rep) rep.phase = 'idle'; renderReport(); }
			else renderReport();
		}, 1000);
		new ResizeObserver(() => { if (!current && !chooser) stub.hidden = !narrow(); }).observe(root);
	}

	document.querySelectorAll<HTMLElement>('.qmap').forEach(initQueue);
	// Печать и сохранение в PDF: все строки и группа «Закрыто сейчас» раскрыты (name снимаем — иначе раскрыта только одна).
	const opened = new Set<HTMLDetailsElement>();
	window.addEventListener('beforeprint', () => {
		document.querySelectorAll<HTMLDetailsElement>('.bl-row, .bl-closed').forEach((d) => {
			if (d.open) opened.add(d);
			d.removeAttribute('name');
			d.open = true;
		});
	});
	window.addEventListener('afterprint', () => {
		document.querySelectorAll<HTMLDetailsElement>('.bl-row, .bl-closed').forEach((d) => {
			d.open = opened.has(d);
			if (d.classList.contains('bl-row')) d.setAttribute('name', 'branch');
		});
		opened.clear();
	});
</script>
