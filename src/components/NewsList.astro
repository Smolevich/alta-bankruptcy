---
import { getCollection } from 'astro:content';

import { viewerSrc } from '../data/pdfs';
import FormCards from './FormCards.astro';
import { formatDate, UI, type Lang } from '../i18n';

const { limit, lang = 'ru' } = Astro.props as { limit?: number; lang?: Lang };
const PUBLISHER = UI[lang].publisher;

const all = (await getCollection('news', (n) => n.id.startsWith(`${lang}/`))).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime() || b.data.order - a.data.order,
);
const items = limit ? all.slice(0, limit) : all;
const fmt = (d: Date) => formatDate(d, lang);
---

<ol class="news not-content">
	{
		items.map((n) => (
			<li>
				<div class="news-meta">
					<time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
					<span class={`pub pub-${n.data.publisher}`}>{PUBLISHER[n.data.publisher]}</span>
				</div>
				<h3>{n.data.title}</h3>
				{n.data.outdated && (
					<p class="news-outdated">
						<strong>{UI[lang].outdated}:</strong> {n.data.outdated.note}
						{n.data.outdated.links.map((l) => (
							<>
								{' '}
								<a href={l.href}>{l.label}</a>
							</>
						))}
					</p>
				)}
				{n.data.aside && <p class="news-aside">{n.data.aside}</p>}
				<p>{n.data.summary}</p>
				{n.data.forms && !limit && <FormCards forms={n.data.forms} lang={lang} fields={false} />}
				<p class="news-src">
					{n.data.sources.map((s, i) => (
						<>
							{i > 0 && ' · '}
							<a href={s.url} target="_blank" rel="noopener" data-pdf={viewerSrc(s.url)}>{s.title}</a>
						</>
					))}
				</p>
			</li>
		))
	}
</ol>
