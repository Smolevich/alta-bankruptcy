---

<figure class="own not-content" aria-label={T.aria}>
	<div class="own-node own-person">
		<span class="own-kind">{T.personKind}</span>
		<strong class="own-name">{T.person}</strong>
	</div>

	<div class="own-edge">
		<span class="own-edge-label">{T.e1} {[1].map((n) => <a class="own-ref" href={`#${id}-${n}`}>{n}</a>)}</span>
	</div>

	<div class="own-node own-group">
		<strong class="own-name">{T.group}</strong>
		<span class="own-id">{T.groupId}</span>
		<ul class="own-facts">
			<li>{T.groupWhat} <a class="own-ref" href={`#${id}-6`}>6</a></li>
			<li class="own-bad">{T.groupLic} <a class="own-ref" href={`#${id}-6`}>6</a></li>
			<li class="own-warn">{T.groupBlock} <a class="own-ref" href={`#${id}-8`}>8</a></li>
			<li>{T.groupApr} <a class="own-ref" href={`#${id}-1`}>1</a></li>
		</ul>
	</div>

	<div class="own-edge own-edge-split">
		<span class="own-edge-label">{T.e2} {[2, 3, 4].map((n) => <a class="own-ref" href={`#${id}-${n}`}>{n}</a>)}</span>
		<p class="own-split">{T.split} <a class="own-ref" href={`#${id}-7`}>7</a></p>
	</div>

	<div class="own-node own-bank">
		<strong class="own-name">{T.bank}</strong>
		<span class="own-id">{T.bankId}</span>
		<ul class="own-facts">
			<li>{T.bankWhat} <a class="own-ref" href={`#${id}-5`}>5</a></li>
			<li class="own-bad">{T.bankLic} <a class="own-ref" href={`#${id}-5`}>5</a></li>
			<li class="own-bad">{T.bankStecaj} <a class="own-ref" href={`#${id}-7`}>7</a></li>
		</ul>
	</div>

	<div class="own-edge own-edge-fork">
		<span class="own-edge-label">{T.e3} <a class="own-ref" href={`#${id}-4`}>4</a></span>
	</div>

	<div class="own-kids">
		<div class="own-node own-kid">
			<span class="own-share">{T.since}</span>
			<strong class="own-name">{T.leasing}</strong>
			<span class="own-id">{T.leasingNote}</span>
		</div>
		<div class="own-node own-kid">
			<span class="own-share">{T.at}</span>
			<strong class="own-name">{T.bitola}</strong>
			<span class="own-id">{T.bitolaNote}</span>
		</div>
	</div>

	<figcaption class="own-src">
		<p class="own-src-h">{T.srcTitle}</p>
		<ol>
			{SOURCES.map((s, i) => (
				<li id={`${id}-${i + 1}`}>
					<a href={s.url} target="_blank" rel="noopener">{s.label[lang]}</a>
