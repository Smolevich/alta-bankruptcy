---

<figure class="own not-content" aria-label={T.aria}>
	<div class="own-legend">
		{(['ok', 'bad', 'dead', 'warn'] as const).map((k, i) => <span><i class={`own-dot own-d-${k}`}></i>{T.legend[i]}</span>)}
	</div>

	<div class="own-node own-person">
		<span class="own-ico" set:html={ICON.person} />
		<span class="own-kind">{T.personKind}</span>
		<strong class="own-name">{T.person}</strong>
	</div>

	<div class="own-edge"><span class="own-pill">{T.e1} <a class="own-ref" href={ref(1)}>1</a></span></div>

	<div class="own-node own-group">
		<span class="own-ico" set:html={ICON.office} />
		<strong class="own-name">{T.group}</strong>
		<span class="own-id">{T.groupId} · {T.groupNotBank}</span>
		<div class="own-body">
			<p class="own-what">{T.groupWhat} <a class="own-ref" href={ref(6)}>6</a></p>
			<p class="own-st own-st-ok"><Fragment set:html={ICON.ok} /><span>{T.groupApr} <a class="own-ref" href={ref(1)}>1</a></span></p>
			<p class="own-st own-st-bad"><Fragment set:html={ICON.bad} /><span>{T.groupLic} <a class="own-ref" href={ref(6)}>6</a></span></p>
			<p class="own-st own-st-warn"><Fragment set:html={ICON.lock} /><span>{T.groupBlock} <a class="own-ref" href={ref(8)}>8</a></span></p>
		</div>
	</div>

	<div class="own-edge"><span class="own-pill">{T.e2} {[2, 3, 4].map((n) => <a class="own-ref" href={ref(n)}>{n}</a>)}</span></div>

	<div class="own-wall"><p><strong>{T.splitHead}</strong>{T.split} <a class="own-ref" href={ref(7)}>7</a></p></div>
	<div class="own-edge own-edge-short"><span></span></div>

	<div class="own-node own-bank">
		<span class="own-ico" set:html={ICON.bank} />
		<strong class="own-name">{T.bank}</strong>
		<span class="own-id">{T.bankId}</span>
		<div class="own-body">
			<span><span class="own-here">{T.bankWhat} <a class="own-ref" href={ref(5)}>5</a></span></span>
			<p class="own-st own-st-bad"><Fragment set:html={ICON.bad} /><span>{T.bankLic} <a class="own-ref" href={ref(5)}>5</a></span></p>
			<p class="own-st own-st-dead"><Fragment set:html={ICON.dead} /><span>{T.bankStecaj} <a class="own-ref" href={ref(7)}>7</a></span></p>
		</div>
	</div>

	<div class="own-fork-label"><span class="own-pill">{T.e3} <a class="own-ref" href={ref(4)}>4</a></span></div>
	<div class="own-fork"></div>

	<div class="own-kids">
		<div class="own-node own-kid">
			<span class="own-ico" set:html={ICON.car} />
			<span class="own-share">{T.sinceShare} <small>{T.since}</small></span>
			<div class="own-body">
				<strong class="own-name">{T.leasing}</strong>
				<span class="own-id">{T.leasingNote}</span>
			</div>
		</div>
		<div class="own-node own-kid">
			<span class="own-ico" set:html={ICON.bank} />
			<span class="own-share">{T.atShare} <small>{T.at}</small></span>
			<div class="own-body">
				<strong class="own-name">{T.bitola}</strong>
				<span class="own-id">{T.bitolaNote}</span>
			</div>
		</div>
	</div>

	<figcaption class="own-src">
		<p class="own-src-h">{T.srcTitle}</p>
		<ol>
			{SOURCES.map((s, i) => (
				<li id={`${id}-${i + 1}`}>
					<a href={s.url} target="_blank" rel="noopener">{s.label[lang]}</a>
					{'copy' in s && s.copy && (<>{' ('}<a href={s.copy} target="_blank" rel="noopener">{T.copy}</a>{')'}</>)}
				</li>
			))}
		</ol>
	</figcaption>
</figure>
