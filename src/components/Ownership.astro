	bad: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="m7 7 6 6M13 7l-6 6" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>',
	dead: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#fff"/><path d="M6 10h8" stroke="#1b2430" stroke-width="2.4" stroke-linecap="round"/></svg>',
	lock: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><rect x="6.5" y="9" width="7" height="5.5" rx="1" fill="#fff"/><path d="M8 9V7.5a2 2 0 0 1 4 0V9" stroke="#fff" stroke-width="1.6" fill="none"/></svg>',
