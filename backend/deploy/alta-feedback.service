[Unit]
Description=ALTA feedback form (alta.smolevich.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/alta-feedback
# ADMIN_TOKEN, IP_SALT and DATA_DIR are put by the deploy from Vault; the process creates the SQLite schema itself.
# --no-access-log: access lines would contain the visitor IP, and we do not store IPs.
EnvironmentFile=/opt/alta-feedback/.env
ExecStart=/opt/alta-feedback/.venv/bin/python -m uvicorn --factory alta_feedback.main:create_app --host 127.0.0.1 --port 8101 --no-server-header --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
# ProtectHome is not set: the python venv is a link to the uv interpreter in /root/.local.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/alta-feedback/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
