[Unit]
Description=ALTA site and forms (alta.smolevich.com), deployed from alta-bankruptcy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/alta-bankruptcy
# ADMIN_TOKEN, IP_SALT and DATA_DIR are put by the deploy from Vault; the process creates the SQLite schema itself.
# Where the service may write (ReadWritePaths) is set by the deploy in the data.conf drop-in: before the traffic
# switch it is a copy of the database, and the old service's live database cannot be changed by it.
# --no-access-log: access lines would contain the visitor IP, and we do not store IPs.
EnvironmentFile=/opt/alta-bankruptcy/.env
ExecStart=/opt/alta-bankruptcy/.venv/bin/python -m uvicorn --factory alta_feedback.main:create_app --host 127.0.0.1 --port 8102 --no-server-header --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
# ProtectHome is not set: the python venv is a link to the uv interpreter in /root/.local.
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
