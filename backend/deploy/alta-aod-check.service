[Unit]
Description=ALTA: daily check of the AOD PDF archive (alta.smolevich.com/docs/aod)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/alta-bankruptcy
# Код и venv — из деплоя alta-bankruptcy; архив лежит рядом с живой базой.
# .env сервиса не читаем: секреты проверке не нужны. tar.gz архива кладём к ночным бэкапам
# ботов, откуда hetzner-offsite-backup уносит его в R2 (шифрованно).
Environment=DATA_DIR=/opt/alta-feedback/data
Environment=AOD_BACKUP_DIR=/var/backups/bots/alta-aod
# Тем же запуском — tar.gz фото и PDF из картотеки кейсов (data/case-files): база в ночном бэкапе
# ботов, а файлы рядом с ней туда не попадают.
Environment=CASES_BACKUP_DIR=/var/backups/bots/alta-cases
ExecStart=/opt/alta-bankruptcy/.venv/bin/python -m alta_feedback.aod_archive
ExecStart=/opt/alta-bankruptcy/.venv/bin/python -m alta_feedback.uploads
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/alta-feedback/data /var/backups/bots
PrivateTmp=yes
