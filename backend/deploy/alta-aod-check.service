[Unit]
Description=ALTA: daily check of the AOD PDF archive (alta.smolevich.com/docs/aod)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/alta-bankruptcy
# Code and venv come from the alta-bankruptcy deploy; the archive lives next to the live database.
# The service .env is not read: the check needs no secrets. The archive tar.gz goes to the nightly backups
# of the bots, from where hetzner-offsite-backup carries it to R2 (encrypted).
Environment=DATA_DIR=/opt/alta-feedback/data
Environment=AOD_BACKUP_DIR=/var/backups/bots/alta-aod
# The same run makes a tar.gz of photos and PDFs from the case registry (data/case-files): the database is in the nightly backup
# of the bots, but the files next to it do not get there.
Environment=CASES_BACKUP_DIR=/var/backups/bots/alta-cases
ExecStart=/opt/alta-bankruptcy/.venv/bin/python -m alta_feedback.aod_archive
ExecStart=/opt/alta-bankruptcy/.venv/bin/python -m alta_feedback.uploads
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/alta-feedback/data /var/backups/bots
PrivateTmp=yes
